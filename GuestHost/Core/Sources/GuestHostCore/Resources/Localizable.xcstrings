    },
    "Later" : {
      "comment" : "VoiceOver's name for the close button of the update card.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "後で"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "稍后"
