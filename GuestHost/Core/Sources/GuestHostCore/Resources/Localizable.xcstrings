    "How to update" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップデート方法"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如何更新"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如何更新"
          }
        }
      }
    },
    "Install it with the app or computer you installed this one with." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このAppをインストールしたときのAppまたはコンピュータでインストールします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用安装此App时所用的App或电脑进行安装。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用安裝此App時所用的App或電腦來安裝。"
          }
        }
      }
    },
    "Install it with the same Apple ID and the same app you installed this one with: it replaces this version and your virtual machine stays. With another Apple ID it becomes a second app, without your virtual machine." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このAppをインストールしたときと同じApple IDと同じAppでインストールしてください。このバージョンが置き換えられ、仮想マシンは残ります。別のApple IDでインストールすると、仮想マシンのない2つ目のAppになります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请使用同一个Apple ID和安装此App时所用的App进行安装：新版本会替换此版本，你的虚拟机会保留。使用其他Apple ID安装会得到第二个App，其中没有你的虚拟机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請使用同一個Apple ID和安裝此App時所用的App來安裝：新版本會取代此版本，你的虛擬機器會保留。使用其他Apple ID安裝會成為第二個App，其中沒有你的虛擬機器。"
          }
        }
      }
    },
    "Installed" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストール済み"
          }
