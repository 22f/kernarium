        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "稍後"
          }
        }
      }
    },
    "Once a day, %@ reads one small file from where its updates are published, to see whether a newer version exists. It sends no account, identifier or usage data." : {
      "comment" : "%@ is the application's name.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は1日に1回、アップデートの公開場所から小さなファイルを1つ読み込み、新しいバージョンがあるかどうかを確認します。アカウント、識別子、使用状況のデータは送信しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@每天从其更新的发布位置读取一个小文件，以查看是否有新版本。它不会发送任何账户、标识符或使用数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@每天會從其更新的發佈位置讀取一個小檔案，以查看是否有較新的版本。它不會傳送任何帳號、識別碼或使用資料。"
          }
        }
      }
    },
