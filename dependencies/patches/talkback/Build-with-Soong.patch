index 0000000000000000000000000000000000000000..6d83e9e472fd06564145227069bbf20e54775cb9
--- /dev/null
+++ b/talkback/Android.bp
@@ -0,0 +1,40 @@
+// SPDX-License-Identifier: Apache-2.0
+
+// The TalkBack service and its settings: the phone flavor of the Gradle :talkback
+// module (src/main and src/phone; src/wear belongs to the watch build). The values
+// the Gradle build generates are written beside the sources: BuildConfig and the
+// app_id string (src/soong).
+android_library {
+    name: "TalkBack-talkback",
+    defaults: ["TalkBack-defaults"],
+    srcs: [
+        "src/main/java/**/*.java",
+        "src/main/java/**/*.kt",
+        "src/phone/java/**/*.java",
+        "src/phone/java/**/*.kt",
+        "src/soong/java/**/*.java",
+    ],
+    resource_dirs: [
+        "src/main/res",
+        "src/soong/res",
+    ],
+    manifest: "src/main/AndroidManifest.xml",
+    // Annotations of the Kotlin and JetBrains packages the sources import.
+    libs: ["kotlin-annotations"],
+    static_libs: [
+        "TalkBack-proguard",
+        "TalkBack-utils",
+        "TalkBack-brailleime",
+        "TalkBack-braille-interfaces",
+        "TalkBack-braille-display",
+        "TalkBack-material-flags",
+        "TalkBack-material-preference",
+        "androidx-constraintlayout_constraintlayout",
+        "androidx.activity_activity",
