+<?xml version="1.0" encoding="utf-8"?>
+<!-- SPDX-License-Identifier: Apache-2.0 -->
+<!-- The app's manifest for the Soong build: src/main/AndroidManifest.xml with the
+     package and version the Gradle build sets (namespace, applicationId,
+     versionName). The SDK levels come from the module's properties. -->
+<manifest xmlns:android="http://schemas.android.com/apk/res/android"
+    package="com.android.talkback"
+    android:versionCode="1"
+    android:versionName="TfPu_release_16_2">
+
+  <!-- The <queries> element allows us to ask the package manager about the
+  installation status of external components we are interested in. -->
+  <queries>
+    <intent>
+      <action android:name="android.intent.action.TTS_SERVICE" />
+    </intent>
+    <intent>
+      <action android:name="android.speech.RecognitionService" />
+    </intent>
+  </queries>
+
+  <application
+     android:name="com.google.android.accessibility.talkback.TalkBackApplication"
+     android:enableOnBackInvokedCallback="true"
+     />
+
+</manifest>
diff --git a/talkback/Android.bp b/talkback/Android.bp
