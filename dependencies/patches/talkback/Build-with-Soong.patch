diff --git a/braille/translate/Android.bp b/braille/translate/Android.bp
new file mode 100644
index 0000000000000000000000000000000000000000..892bd3e584db73db4040cbcefea461d8daad643a
--- /dev/null
+++ b/braille/translate/Android.bp
@@ -0,0 +1,74 @@
+// SPDX-License-Identifier: Apache-2.0
+
+// The braille translation module: the Java side, the translation tables as a raw
+// resource (the Gradle build zips them into res/raw), liblouis and the JNI wrapper.
+android_library {
+    name: "TalkBack-braille-translate",
+    defaults: ["TalkBack-defaults"],
+    srcs: [
+        "src/main/java/**/*.java",
+        "src/phone/java/**/*.java",
+    ],
+    resource_zips: [
+        ":TalkBack-braille-translation-tables-res",
+    ],
+    manifest: "src/phone/AndroidManifest.xml",
+    static_libs: [
+        "TalkBack-braille-interfaces",
+        "TalkBack-proguard",
+        "TalkBack-utils",
+    ],
+}
+
+// res/raw/translationtables.zip: the tables below liblouis/tables.
+genrule {
+    name: "TalkBack-braille-translation-tables-res",
+    srcs: ["src/phone/tables/**/*"],
+    out: ["translationtables.res.zip"],
+    tools: ["soong_zip"],
+    cmd: "mkdir -p $(genDir)/res/raw && " +
+        "$(location soong_zip) -o $(genDir)/res/raw/translationtables.zip -P liblouis/tables " +
+        "-C external/talkback/braille/translate/src/phone/tables -D external/talkback/braille/translate/src/phone/tables && " +
+        "$(location soong_zip) -o $(out) -C $(genDir)/res -D $(genDir)/res",
+}
+
+cc_library_static {
+    name: "talkback_liblouis",
+    defaults: ["TalkBack-native-defaults"],
+    licenses: ["external_talkback_liblouis_license"],
+    srcs: [
+        "src/phone/jni/third_party/liblouis/liblouis/commonTranslationFunctions.c",
+        "src/phone/jni/third_party/liblouis/liblouis/compileTranslationTable.c",
+        "src/phone/jni/third_party/liblouis/liblouis/logging.c",
+        "src/phone/jni/third_party/liblouis/liblouis/lou_backTranslateString.c",
+        "src/phone/jni/third_party/liblouis/liblouis/lou_translateString.c",
+        "src/phone/jni/third_party/liblouis/liblouis/maketable.c",
+        "src/phone/jni/third_party/liblouis/liblouis/metadata.c",
+        "src/phone/jni/third_party/liblouis/liblouis/pattern.c",
+        "src/phone/jni/third_party/liblouis/liblouis/utils.c",
+    ],
+    local_include_dirs: [
+        "src/phone/jni/third_party/liblouis",
+        "src/phone/jni/third_party/liblouis/liblouis",
+    ],
+    cflags: ["-DTABLESDIR=\"__non_existent_path__\""],
+}
+
+cc_library_shared {
+    name: "talkback_louiswrap",
+    stem: "liblouiswrap",
+    defaults: ["TalkBack-native-defaults"],
+    licenses: ["external_talkback_license"],
+    stl: "c++_static",
+    srcs: ["src/phone/jni/liblouiswrapper/louis_translation.cc"],
+    local_include_dirs: [
+        "src/phone/jni",
+        "src/phone/jni/third_party/liblouis",
+    ],
+    include_dirs: ["external/talkback/braille/common/src/phone/jni"],
+    whole_static_libs: ["talkback_liblouis"],
+    shared_libs: [
+        "libandroid",
+        "liblog",
+    ],
+}
