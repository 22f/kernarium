--- /dev/null
+++ b/braille/brltty/Android.bp
@@ -0,0 +1,394 @@
+// SPDX-License-Identifier: Apache-2.0
+
+// The BRLTTY braille display drivers and their Java side: the key tables as a raw
+// resource (the Gradle build zips them into res/raw), libbrltty with the drivers the
+// build selects, and the JNI wrapper.
+android_library {
+    name: "TalkBack-braille-brltty",
+    defaults: ["TalkBack-defaults"],
+    srcs: [
+        "src/main/java/**/*.java",
+        "src/phone/java/**/*.java",
+    ],
+    resource_dirs: [
+        "src/phone/res",
+    ],
+    resource_zips: [
+        ":TalkBack-braille-brltty-key-tables-res",
+    ],
+    manifest: "src/phone/AndroidManifest.xml",
+    static_libs: [
+        "TalkBack-braille-interfaces",
+        "TalkBack-braille-translate",
+        "TalkBack-braille-common",
+        "TalkBack-proguard",
+        "TalkBack-utils",
+    ],
+}
+
+// res/raw/keytables.zip: the key tables.
+genrule {
+    name: "TalkBack-braille-brltty-key-tables-res",
+    srcs: ["src/phone/tables/**/*"],
+    out: ["keytables.res.zip"],
+    tools: ["soong_zip"],
+    cmd: "mkdir -p $(genDir)/res/raw && " +
+        "$(location soong_zip) -o $(genDir)/res/raw/keytables.zip " +
+        "-C external/talkback/braille/brltty/src/phone/tables -D external/talkback/braille/brltty/src/phone/tables && " +
+        "$(location soong_zip) -o $(out) -C $(genDir)/res -D $(genDir)/res",
+}
+
+cc_defaults {
+    name: "talkback_brltty_defaults",
+    defaults: ["TalkBack-native-defaults"],
+    licenses: ["external_talkback_brltty_license"],
+    c_std: "c99",
+    local_include_dirs: [
+        "src/phone/jni/brlttywrapper/third_party/brltty",
+        "src/phone/jni/brlttywrapper/third_party/brltty/Programs",
+        "src/phone/jni/brlttywrapper/third_party/brltty/Headers",
+        "src/phone/jni/brlttywrapper",
+    ],
+    cflags: [
+        "-DHAVE_CONFIG_H",
+        // The driver tables record the compile date and time (__DATE__,
+        // __TIME__), as the upstream code does.
+        "-Wno-date-time",
+    ],
+}
