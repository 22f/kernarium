diff --git a/src/venus/vkr_pipeline.c b/src/venus/vkr_pipeline.c
index d0d6f8364bf6c109bc31e5d01940853ce42669cc..514a39fa8f1a0b34edaae7f504404b79d05f0e87 100644
--- a/src/venus/vkr_pipeline.c
+++ b/src/venus/vkr_pipeline.c
@@ -105,6 +105,32 @@ vkr_dispatch_vkMergePipelineCaches(UNUSED struct vn_dispatch_context *dispatch,
                                        args->pSrcCaches);
 }
 
+/* A pipeline is created from binaries when its create info chains a
+ * VkPipelineBinaryInfoKHR, and the driver reads every binary it names.  The
+ * codec looks each handle up and yields NULL for object id 0, which no
+ * pipeline-binary object has, leaving the refusal to the handler (an id the
+ * context never made is refused by the lookup itself).  A null binary is
+ * therefore a null pointer the driver would dereference.  The handles still
+ * hold the objects here; they are replaced by the driver's handles only when
+ * the call is forwarded. */
+static bool
+vkr_pipeline_binary_infos_hold_binaries(const void *pnext)
+{
+   for (const VkBaseInStructure *chain = pnext; chain; chain = chain->pNext) {
+      if (chain->sType != VK_STRUCTURE_TYPE_PIPELINE_BINARY_INFO_KHR)
+         continue;
+
+      const VkPipelineBinaryInfoKHR *info = (const VkPipelineBinaryInfoKHR *)chain;
+      if (info->binaryCount && !info->pPipelineBinaries)
+         return false;
+      for (uint32_t i = 0; i < info->binaryCount; i++) {
+         if (!info->pPipelineBinaries[i])
+            return false;
+      }
+   }
+   return true;
+}
+
 static void
 vkr_dispatch_vkCreateGraphicsPipelines(struct vn_dispatch_context *dispatch,
                                        struct vn_command_vkCreateGraphicsPipelines *args)
@@ -114,6 +140,13 @@ vkr_dispatch_vkCreateGraphicsPipelines(struct vn_dispatch_context *dispatch,
    struct vkr_device *dev = vkr_device_from_handle(args->device);
    struct object_array arr;
 
+   for (uint32_t i = 0; i < args->createInfoCount; i++) {
+      if (!vkr_pipeline_binary_infos_hold_binaries(args->pCreateInfos[i].pNext)) {
+         vkr_context_set_fatal(ctx);
+         return;
+      }
+   }
+
    if (!vkr_graphics_pipeline_create_array(ctx, args, &arr))
       return;
 
@@ -129,6 +162,13 @@ vkr_dispatch_vkCreateComputePipelines(struct vn_dispatch_context *dispatch,
    struct vkr_device *dev = vkr_device_from_handle(args->device);
    struct object_array arr;
 
+   for (uint32_t i = 0; i < args->createInfoCount; i++) {
+      if (!vkr_pipeline_binary_infos_hold_binaries(args->pCreateInfos[i].pNext)) {
+         vkr_context_set_fatal(ctx);
+         return;
+      }
+   }
+
    if (!vkr_compute_pipeline_create_array(ctx, args, &arr))
       return;
 
@@ -152,6 +192,13 @@ vkr_dispatch_vkCreateRayTracingPipelinesKHR(
    struct vkr_device *dev = vkr_device_from_handle(args->device);
    struct object_array arr;
 
+   for (uint32_t i = 0; i < args->createInfoCount; i++) {
+      if (!vkr_pipeline_binary_infos_hold_binaries(args->pCreateInfos[i].pNext)) {
+         vkr_context_set_fatal(ctx);
+         return;
+      }
+   }
+
    if (!vkr_ray_tracing_pipeline_create_array(ctx, args, &arr))
       return;
 
@@ -199,6 +246,261 @@ vkr_dispatch_vkGetRayTracingShaderGroupStackSizeKHR(
                                                         args->group, args->groupShader);
 }
 
+/* A key says how much of key[] is valid in keySize, and the codec decodes that
+ * field as a plain number beside a key array of exactly
+ * VK_MAX_PIPELINE_BINARY_KEY_SIZE_KHR bytes: whatever keySize the guest wrote,
+ * only that many key bytes arrive.  The registry marks keySize
+ * noautovalidity, so nothing else bounds it, and a driver that trusts it
+ * reads, and may copy, bytes past the end of the decoded key.
+ *
+ * The driver this renderer serves names a binary by one 32-byte hash, which
+ * fills the whole key array, so it refuses every other size itself.  Refuse it
+ * here as well, before the call is forwarded, so that the renderer never hands
+ * a driver a key that claims more bytes than it decoded. */
+static bool
+vkr_pipeline_binary_keys_are_sized(const VkPipelineBinaryKeysAndDataKHR *import)
+{
+   for (uint32_t i = 0; i < import->binaryCount; i++) {
+      if (import->pPipelineBinaryKeys[i].keySize != VK_MAX_PIPELINE_BINARY_KEY_SIZE_KHR)
+         return false;
+   }
+   return true;
+}
+
+static void
+vkr_dispatch_vkCreatePipelineBinariesKHR(
+   struct vn_dispatch_context *dispatch,
+   struct vn_command_vkCreatePipelineBinariesKHR *args)
+{
+   TRACE_FUNC();
+   struct vkr_context *ctx = dispatch->data;
+   struct vkr_device *dev = vkr_device_from_handle(args->device);
+   struct vn_device_proc_table *vk = &dev->proc_table;
+   struct object_array arr;
+
+   /* VK_ERROR_VALIDATION_FAILED is the result a command gives when the
+    * implementation detects invalid usage, and the driver gives the same one
+    * for a key it refuses.  The whole call is refused: no object is made for
+    * any of its binaries.
+    *
+    * The binaries come from the keys and data to import, from a pipeline, or
+    * from a pipeline create info, and a request that names none of them has
+    * nothing to read: the driver would dereference the import it does not
+    * have. */
+   if (!args->pCreateInfo->pKeysAndDataInfo && !args->pCreateInfo->pipeline &&
+       !args->pCreateInfo->pPipelineCreateInfo) {
+      vkr_log("vkCreatePipelineBinariesKHR: the request names no source for its "
+              "binaries");
+      args->ret = VK_ERROR_VALIDATION_FAILED;
+      return;
+   }
+
+   if (args->pCreateInfo->pKeysAndDataInfo &&
+       !vkr_pipeline_binary_keys_are_sized(args->pCreateInfo->pKeysAndDataInfo)) {
+      vkr_log("vkCreatePipelineBinariesKHR: a key is not %u bytes",
+              VK_MAX_PIPELINE_BINARY_KEY_SIZE_KHR);
+      args->ret = VK_ERROR_VALIDATION_FAILED;
+      return;
+   }
+
+   /* The count is an in-out parameter, and the driver asks how many binaries
+    * a pipeline has before it names any, so a query carries no handles and
+    * creates no objects. */
+   if (!args->pBinaries->pPipelineBinaries) {
+      vn_replace_vkCreatePipelineBinariesKHR_args_handle(args);
+      args->ret = vk->CreatePipelineBinariesKHR(args->device, args->pCreateInfo, NULL,
+                                                args->pBinaries);
+      return;
+   }
+
+   const uint32_t count = args->pBinaries->pipelineBinaryCount;
+   if (!object_array_init(ctx, &arr, count, VK_OBJECT_TYPE_PIPELINE_BINARY_KHR,
+                          sizeof(struct vkr_pipeline_binary),
+                          sizeof(*args->pBinaries->pPipelineBinaries),
+                          args->pBinaries->pPipelineBinaries)) {
+      args->ret = VK_ERROR_OUT_OF_HOST_MEMORY;
+      return;
+   }
+
+   /* The driver writes the handles of the binaries it makes and none of the
+    * others, so the array is cleared first: a handle that is still null names
+    * no binary. */
+   VkPipelineBinaryKHR *natives = arr.handle_storage;
+   memset(natives, 0, sizeof(*natives) * count);
+
+   VkPipelineBinaryHandlesInfoKHR handles = *args->pBinaries;
+   handles.pPipelineBinaries = natives;
+
+   vn_replace_vkCreatePipelineBinariesKHR_args_handle(args);
+   args->ret =
+      vk->CreatePipelineBinariesKHR(args->device, args->pCreateInfo, NULL, &handles);
+
+   /* The driver keeps the binaries it made before a failure and returns the
+    * first failure it met, so a result that is not published leaves binaries
+    * the renderer owns and no object names.  VK_PIPELINE_BINARY_MISSING_KHR is a
+    * success code of this command: it says the entries the driver could not
+    * make are null, as it does the entries a smaller count leaves, and the
+    * guest keeps the ids of the binaries that were made. */
+   if (args->ret != VK_SUCCESS && args->ret != VK_INCOMPLETE &&
+       args->ret != VK_PIPELINE_BINARY_MISSING_KHR) {
+      for (uint32_t i = 0; i < count; i++) {
+         if (natives[i] != VK_NULL_HANDLE)
+            vk->DestroyPipelineBinaryKHR(args->device, natives[i], NULL);
+      }
+      object_array_fini(&arr);
+      return;
+   }
+
+   /* The driver may have produced fewer binaries than the guest offered
+    * handles for; the objects it did not fill are not created. */
+   args->pBinaries->pipelineBinaryCount = handles.pipelineBinaryCount;
+
+   for (uint32_t i = 0; i < count; i++) {
+      struct vkr_pipeline_binary *obj = arr.objects[i];
+
+      obj->base.handle.pipeline_binary =
+         i < handles.pipelineBinaryCount
+            ? ((VkPipelineBinaryKHR *)arr.handle_storage)[i]
+            : VK_NULL_HANDLE;
+
+      if (obj->base.handle.pipeline_binary == VK_NULL_HANDLE) {
+         free(obj);
+         arr.objects[i] = NULL;
+         args->pBinaries->pPipelineBinaries[i] = VK_NULL_HANDLE;
+      } else {
+         vkr_device_add_object(ctx, dev, &obj->base);
+      }
+   }
+
+   arr.objects_stolen = true;
+   object_array_fini(&arr);
+}
+
+static void
+vkr_dispatch_vkDestroyPipelineBinaryKHR(
+   struct vn_dispatch_context *dispatch,
+   struct vn_command_vkDestroyPipelineBinaryKHR *args)
+{
+   struct vkr_context *ctx = dispatch->data;
+   struct vkr_device *dev = vkr_device_from_handle(args->device);
+   struct vn_device_proc_table *vk = &dev->proc_table;
+   struct vkr_pipeline_binary *obj =
+      vkr_pipeline_binary_from_handle(args->pipelineBinary);
+   if (!obj)
+      return;
+
+   vn_replace_vkDestroyPipelineBinaryKHR_args_handle(args);
+   vk->DestroyPipelineBinaryKHR(args->device, args->pipelineBinary, NULL);
+
+   vkr_device_remove_object(ctx, dev, &obj->base);
+}
+
+static void
+vkr_dispatch_vkGetPipelineKeyKHR(UNUSED struct vn_dispatch_context *dispatch,
+                                 struct vn_command_vkGetPipelineKeyKHR *args)
+{
+   TRACE_FUNC();
+   struct vkr_device *dev = vkr_device_from_handle(args->device);
+   struct vn_device_proc_table *vk = &dev->proc_table;
+
+   /* The key is an out parameter: the codec decodes only its type and chain, so
+    * its size and bytes are whatever the decoder's temp pool held last, and a
+    * reply the driver does not fill would hand them back to the guest.  The
+    * pointer is not optional, so the codec ends the context when the guest
+    * sends none. */
+   args->pPipelineKey->keySize = 0;
+   memset(args->pPipelineKey->key, 0, sizeof(args->pPipelineKey->key));
+
+   /* No create info is the key of the device itself, which the driver serves.
+    * A key for a pipeline is derived from the pipeline create info the caller
+    * chains onto VkPipelineCreateInfoKHR, and the driver reads the first
+    * structure of that chain as the create info of a graphics, compute or ray
+    * tracing pipeline without checking its type.  The protocol carries the
+    * chain, so a request whose first structure is anything else, or that
+    * arrives with none, is one the driver cannot be handed: it would read the
+    * fields of another structure as a pipeline's, past the end of what was
+    * decoded.  The whole call is refused, as are the other requests of this
+    * extension that the implementation finds invalid. */
+   if (args->pPipelineCreateInfo) {
+      const VkBaseInStructure *first = args->pPipelineCreateInfo->pNext;
+      if (!first ||
+          (first->sType != VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO &&
+           first->sType != VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO &&
+           first->sType != VK_STRUCTURE_TYPE_RAY_TRACING_PIPELINE_CREATE_INFO_KHR)) {
+         vkr_log("vkGetPipelineKeyKHR: the create info does not begin with a "
+                 "graphics, compute or ray tracing pipeline's");
+         args->ret = VK_ERROR_VALIDATION_FAILED;
+         return;
+      }
+   }
+
+   vn_replace_vkGetPipelineKeyKHR_args_handle(args);
+   args->ret = vk->GetPipelineKeyKHR(args->device, args->pPipelineCreateInfo,
+                                     args->pPipelineKey);
+}
+
+static void
+vkr_dispatch_vkGetPipelineBinaryDataKHR(
+   struct vn_dispatch_context *dispatch,
+   struct vn_command_vkGetPipelineBinaryDataKHR *args)
+{
+   TRACE_FUNC();
+   struct vkr_context *ctx = dispatch->data;
+   struct vkr_device *dev = vkr_device_from_handle(args->device);
+   struct vn_device_proc_table *vk = &dev->proc_table;
+
+   /* The binary is not optional.  The codec yields NULL for object id 0 and
+    * leaves the refusal to the handler (an id the context never made is
+    * refused by the lookup itself), and the driver reads the binary it is
+    * given. */
+   if (!args->pInfo || !args->pInfo->pipelineBinary) {
+      vkr_context_set_fatal(ctx);
+      return;
+   }
+
+   /* The data size is in-out, and this is the one command whose out value can
+    * exceed the in value: a buffer smaller than the binary is answered with
+    * VK_ERROR_NOT_ENOUGH_SPACE_KHR, the size the caller needs, and no data.
+    * The reply's blob is measured by the size the driver reports, while the
+    * room for it was reserved from the size the driver was offered, so a grown
+    * size describes a blob neither side has: it runs past the reply region the
+    * guest set and past the guest's own buffer.  The specification writes no
+    * data in that case, so the reply carries no blob and the guest reads only
+    * the size it asked for.
+    */
+   const size_t offered =
+      args->pPipelineBinaryDataSize ? *args->pPipelineBinaryDataSize : 0;
+
+   vn_replace_vkGetPipelineBinaryDataKHR_args_handle(args);
+   args->ret = vk->GetPipelineBinaryDataKHR(args->device, args->pInfo,
+                                            args->pPipelineBinaryKey,
+                                            args->pPipelineBinaryDataSize,
+                                            args->pPipelineBinaryData);
+
+   if (args->pPipelineBinaryData && *args->pPipelineBinaryDataSize > offered)
+      args->pPipelineBinaryData = NULL;
+}
+
+static void
+vkr_dispatch_vkReleaseCapturedPipelineDataKHR(
+   struct vn_dispatch_context *dispatch,
+   struct vn_command_vkReleaseCapturedPipelineDataKHR *args)
+{
+   struct vkr_context *ctx = dispatch->data;
+   struct vkr_device *dev = vkr_device_from_handle(args->device);
+   struct vn_device_proc_table *vk = &dev->proc_table;
+
+   /* The pipeline is not optional, and the codec yields NULL for object id 0
+    * as it does for the binary above. */
+   if (!args->pInfo || !args->pInfo->pipeline) {
+      vkr_context_set_fatal(ctx);
+      return;
+   }
+
+   vn_replace_vkReleaseCapturedPipelineDataKHR_args_handle(args);
+   args->ret = vk->ReleaseCapturedPipelineDataKHR(args->device, args->pInfo, NULL);
+}
+
 void
 vkr_context_init_shader_module_dispatch(struct vkr_context *ctx)
 {
@@ -247,3 +549,19 @@ vkr_context_init_pipeline_dispatch(struct vkr_context *ctx)
    dispatch->dispatch_vkGetRayTracingShaderGroupStackSizeKHR =
       vkr_dispatch_vkGetRayTracingShaderGroupStackSizeKHR;
 }
+
+void
+vkr_context_init_pipeline_binary_dispatch(struct vkr_context *ctx)
+{
+   struct vn_dispatch_context *dispatch = &ctx->dispatch;
+
+   dispatch->dispatch_vkCreatePipelineBinariesKHR =
+      vkr_dispatch_vkCreatePipelineBinariesKHR;
+   dispatch->dispatch_vkDestroyPipelineBinaryKHR =
+      vkr_dispatch_vkDestroyPipelineBinaryKHR;
+   dispatch->dispatch_vkGetPipelineKeyKHR = vkr_dispatch_vkGetPipelineKeyKHR;
+   dispatch->dispatch_vkGetPipelineBinaryDataKHR =
+      vkr_dispatch_vkGetPipelineBinaryDataKHR;
+   dispatch->dispatch_vkReleaseCapturedPipelineDataKHR =
+      vkr_dispatch_vkReleaseCapturedPipelineDataKHR;
+}
diff --git a/src/venus/vkr_pipeline.h b/src/venus/vkr_pipeline.h
index a356ebfc6dc9ce5cd01b8eb790026b12da5fc1e3..a64db1f52ab3af3c4092310aab1dc65187e1d83a 100644
--- a/src/venus/vkr_pipeline.h
+++ b/src/venus/vkr_pipeline.h
@@ -28,6 +28,13 @@ struct vkr_pipeline {
 };
 VKR_DEFINE_OBJECT_CAST(pipeline, VK_OBJECT_TYPE_PIPELINE, VkPipeline)
 
+struct vkr_pipeline_binary {
+   struct vkr_object base;
+};
+VKR_DEFINE_OBJECT_CAST(pipeline_binary,
+                       VK_OBJECT_TYPE_PIPELINE_BINARY_KHR,
+                       VkPipelineBinaryKHR)
+
 void
 vkr_context_init_shader_module_dispatch(struct vkr_context *ctx);
 
