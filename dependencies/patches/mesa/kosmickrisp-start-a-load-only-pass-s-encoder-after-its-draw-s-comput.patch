index b8abb9fefcbd59ac4e0d183a304f5b798561fe62..5b1d04b182facdbed46ea0c6f747c80a66e986b1 100644
--- a/src/kosmickrisp/vulkan/kk_query_pool.c
+++ b/src/kosmickrisp/vulkan/kk_query_pool.c
@@ -375,6 +375,12 @@ kk_CmdWriteTimestamp2(VkCommandBuffer commandBuffer,
       .availability_count = count,
    };
 
+   /* The sample of a render stage belongs to the pass's render encoder. A
+    * pass that has not started one starts it for the sample, as the encoder
+    * it would have begun with. */
+   if (mtl_stage && cmd->state.gfx.render.deferred_start)
+      cs_get_render(cmd);
+
    /* non-gfx or not found*/
    if (cmd->gfx.encoder && mtl_stage) {
       /* Metal permits a single timestamp sample for each render stage in an
