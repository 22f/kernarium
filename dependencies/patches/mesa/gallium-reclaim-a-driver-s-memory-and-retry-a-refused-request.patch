diff --git a/src/gallium/auxiliary/util/u_reclaim.c b/src/gallium/auxiliary/util/u_reclaim.c
new file mode 100644
index 0000000000000000000000000000000000000000..ab237e4c01fcb4b3ed6af0704a931ad6c563e7a6
--- /dev/null
+++ b/src/gallium/auxiliary/util/u_reclaim.c
@@ -0,0 +1,179 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "util/u_reclaim.h"
+
+#include "pipe/p_context.h"
+#include "pipe/p_defines.h"
+#include "pipe/p_screen.h"
+#include "util/macros.h"
+#include "util/os_time.h"
+#include "util/u_atomic.h"
+
+/* The most a reclaim waits, in all, for the GPU to finish the caller's work
+ * once the flush has returned. */
+#ifndef U_RECLAIM_FINISH_NS
+#define U_RECLAIM_FINISH_NS (2000ll * 1000 * 1000)
+#endif
+/* How long the room a reclaim freed is waited for: the budget's own
+ * accounting follows a release by a periodic sweep of a quarter of a second
+ * at most. Memory that has not been freed after a short grace is not coming,
+ * and the retry stops waiting for it. */
+#ifndef U_RECLAIM_SETTLE_NS
+#define U_RECLAIM_SETTLE_NS (300ll * 1000 * 1000)
+#endif
+#ifndef U_RECLAIM_GRACE_NS
+#define U_RECLAIM_GRACE_NS (20ll * 1000 * 1000)
+#endif
+#define U_RECLAIM_MIN_FREED (1ull << 20)
+#define U_RECLAIM_POLL_US 4000
+/* How long a reclaim that did not help rules out another of the same
+ * context, and how long one whose work did not finish in time does for the
+ * whole screen: a GPU that is not finishing is not worth waiting for again
+ * soon. */
+#ifndef U_RECLAIM_FUTILE_NS
+#define U_RECLAIM_FUTILE_NS (250ll * 1000 * 1000)
+#endif
+#ifndef U_RECLAIM_HUNG_NS
+#define U_RECLAIM_HUNG_NS (10000ll * 1000 * 1000)
+#endif
+
+/* Raises *until_ns to value_ns, and never lowers it. */
+static void
+rule_out_until(int64_t *until_ns, int64_t value_ns)
+{
+   int64_t current = p_atomic_read(until_ns);
+
+   while (current < value_ns) {
+      const int64_t seen = p_atomic_cmpxchg(until_ns, current, value_ns);
+      if (seen == current)
+         return;
+      current = seen;
+   }
+}
+
+static uint64_t
+freed_since(const struct u_reclaim *reclaim)
+{
+   struct pipe_screen *screen = reclaim->screen;
+   return screen->get_freed_memory ?
+          screen->get_freed_memory(screen) - reclaim->freed_mark : 0;
+}
+
+/* Flushes the context and waits until the deadline for everything it
+ * submitted, which the first call sets once its flush has returned. The
+ * fence is polled, never waited on: a driver that composes its wait from a
+ * wait for the submission and one for the GPU would give each the whole time
+ * it is passed. The deadline is checked before every poll, so a fence that is
+ * ready only after it does not count, and the last sleep ends at it. Returns
+ * false when the work has not finished by the deadline. */
+static bool
+finish(struct pipe_context *pipe, int64_t *deadline_ns)
+{
+   struct pipe_screen *screen = pipe->screen;
+   struct pipe_fence_handle *fence = NULL;
+   bool finished = true;
+
+   pipe->flush(pipe, &fence, PIPE_FLUSH_ASYNC | PIPE_FLUSH_HINT_FINISH);
+   if (!*deadline_ns)
+      *deadline_ns = os_time_get_nano() + U_RECLAIM_FINISH_NS;
+   if (fence) {
+      int64_t sleep_us = 100;
+
+      for (;;) {
+         const int64_t left_ns = *deadline_ns - os_time_get_nano();
+
+         if (left_ns <= 0) {
+            finished = false;
+            break;
+         }
+         if (screen->fence_finish(screen, NULL, fence, 0))
+            break;
+         os_time_sleep(MIN2(sleep_us, MAX2(left_ns / 1000, 1)));
+         sleep_us = MIN2(sleep_us * 2, 2000);
+      }
+      screen->fence_reference(screen, &fence, NULL);
+   }
+   return finished;
+}
+
+bool
+u_reclaim_begin(struct pipe_context *pipe, bool may_finish,
+                struct u_reclaim *reclaim)
+{
+   struct pipe_screen *screen = pipe->screen;
+   const int64_t now = os_time_get_nano();
+
+   if (now < p_atomic_read(&pipe->reclaim_futile_until_ns) ||
+       now < p_atomic_read(&screen->reclaim.hung_until_ns))
+      return false;
+
+   /* One reclaim runs on the screen: the one that holds the claim, until it
+    * ends. A token that is never reused says which end() is its own. */
+   const uint64_t token = p_atomic_inc_return(&screen->reclaim.tokens);
+   if (p_atomic_cmpxchg(&screen->reclaim.claim, 0, token) != 0)
+      return false;
+
+   reclaim->pipe = pipe;
+   reclaim->screen = screen;
+   reclaim->token = token;
+   reclaim->freed_mark = screen->get_freed_memory ?
+                         screen->get_freed_memory(screen) : 0;
+
+   if (may_finish) {
+      int64_t deadline_ns = 0;
+      bool finished = finish(pipe, &deadline_ns);
+
+      if (finished && pipe->trim) {
+         pipe->trim(pipe);
+         /* A threaded context runs the trim on its driver thread, behind
+          * what is queued: finishing again waits for it. */
+         finished = finish(pipe, &deadline_ns);
+      }
+      if (!finished) {
+         /* The GPU has not finished what it was given: what the work holds
+          * is not coming back soon, and the caller's request stays refused.
+          */
+         rule_out_until(&screen->reclaim.hung_until_ns,
+                        os_time_get_nano() + U_RECLAIM_HUNG_NS);
+         p_atomic_cmpxchg(&screen->reclaim.claim, token, 0);
+         reclaim->token = 0;
+         return false;
+      }
+   }
+   if (screen->release_cached_memory)
+      screen->release_cached_memory(screen);
+   reclaim->settled_from_ns = os_time_get_nano();
+   return true;
+}
+
+void
+u_reclaim_settle(struct u_reclaim *reclaim)
+{
+   for (;;) {
+      const int64_t age = os_time_get_nano() - reclaim->settled_from_ns;
+
+      if (age >= U_RECLAIM_SETTLE_NS)
+         return;
+      if (age >= U_RECLAIM_GRACE_NS &&
+          freed_since(reclaim) < U_RECLAIM_MIN_FREED)
+         return;
+      os_time_sleep(U_RECLAIM_POLL_US);
+   }
+}
+
+void
+u_reclaim_end(struct u_reclaim *reclaim, bool recovered)
+{
+   const uint64_t token = reclaim->token;
+
+   /* Only the reclaim that holds the claim gives it up. */
+   if (!token ||
+       p_atomic_cmpxchg(&reclaim->screen->reclaim.claim, token, 0) != token)
+      return;
+   reclaim->token = 0;
+   if (!recovered)
+      rule_out_until(&reclaim->pipe->reclaim_futile_until_ns,
+                     os_time_get_nano() + U_RECLAIM_FUTILE_NS);
+}
diff --git a/src/gallium/auxiliary/util/u_reclaim.h b/src/gallium/auxiliary/util/u_reclaim.h
new file mode 100644
index 0000000000000000000000000000000000000000..c903c206c24657cf117dc06aae911d58ecaa1c58
--- /dev/null
+++ b/src/gallium/auxiliary/util/u_reclaim.h
@@ -0,0 +1,93 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+
+/* Give back the memory a driver holds, and let a refused request run again.
+ *
+ * A driver refuses an allocation when the process's budget is full, and a
+ * budget that is full is often one that still holds memory for work that has
+ * finished: buffers a finished batch still references, storage the driver
+ * caches for reuse. A caller that can run its request again calls
+ * u_reclaim_begin() after the refusal, and when that says a reclaim was made,
+ * u_reclaim_settle(), then runs the request once more and tells
+ * u_reclaim_end() how it went. The request is attempted exactly once after a
+ * reclaim, whatever is freed.
+ *
+ * The room a reclaim frees can show in the budget a little after it is
+ * freed, which is why the retry follows a short wait when the reclaim freed
+ * something. A reclaim that did not help rules out another for that context
+ * for a short time, since a budget that is really full gains nothing from
+ * one, and a caller that keeps meeting the refusal would otherwise finish its
+ * context for each. A reclaim whose work does not finish in time rules out
+ * any for the screen for longer, and only one reclaim runs on a screen at a
+ * time, so that contexts that meet a refusal together do not all wait.
+ *
+ * What it remembers lives in the screen and the context themselves
+ * (pipe_screen::reclaim, pipe_context::reclaim_futile_until_ns), and goes
+ * with them. */
+
+#ifndef U_RECLAIM_H
+#define U_RECLAIM_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct pipe_context;
+struct pipe_screen;
+
+struct u_reclaim {
+   struct pipe_context *pipe;
+   struct pipe_screen *screen;
+   /* the claim this reclaim holds on the screen */
+   uint64_t token;
+   uint64_t freed_mark;
+   int64_t settled_from_ns;
+};
+
+/* Gives back what the driver can for the caller's refused request: when
+ * may_finish is set, the caller's context is flushed, the work it has
+ * submitted finished, and the context trimmed, which lets completed work
+ * release the storage it holds; then the screen releases what it caches.
+ * Set may_finish only on the thread that owns the context, and not in a
+ * call that is not synchronized with it.
+ *
+ * The waiting this adds after the flush has returned is bounded: the two
+ * waits for the GPU (before and after the trim) share 2 s, and the polling
+ * that checks the fence never blocks. The flush itself, and a call that
+ * synchronizes a threaded context before it gets here, wait as they always do
+ * and are not bounded by this.
+ *
+ * The bound is a deadline: the scheduler, and the callbacks the driver is
+ * polled through, can run past it by what they take.
+ *
+ * Returns false when no reclaim was made, and the caller's request stays
+ * refused: this context's last reclaim did not help a moment ago, another
+ * reclaim is running on the screen, or the work did not finish in time, which
+ * rules out any reclaim on the screen for ten seconds. When it returns true,
+ * the caller holds the screen's one reclaim until it calls u_reclaim_end(),
+ * which it must, whatever the retry does. */
+bool
+u_reclaim_begin(struct pipe_context *pipe, bool may_finish,
+                struct u_reclaim *reclaim);
+
+/* Waits, for at most 300 ms, for the room the reclaim freed to show in the
+ * budget, which it does not at once. Waits no longer than 20 ms when the
+ * reclaim freed next to nothing. Does not run the request. */
+void
+u_reclaim_settle(struct u_reclaim *reclaim);
+
+/* Records the outcome of the retry and gives up the screen's reclaim. A
+ * struct that was not made by a successful u_reclaim_begin(), or that has
+ * ended already, does nothing. */
+void
+u_reclaim_end(struct u_reclaim *reclaim, bool recovered);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/src/gallium/auxiliary/util/u_reclaim_test.c b/src/gallium/auxiliary/util/u_reclaim_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..260aa2e472e20f89c86aaa1861be09ed52404daa
--- /dev/null
+++ b/src/gallium/auxiliary/util/u_reclaim_test.c
@@ -0,0 +1,498 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+
+/* What bounds a reclaim, and what one context's reclaim does to another's,
+ * against contexts and screens that count what the reclaim asks of them and
+ * answer as the test says. The times of u_reclaim.c are shortened by the
+ * build of this test, which gives them as macros. */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "c11/threads.h"
+#include "pipe/p_context.h"
+#include "pipe/p_defines.h"
+#include "pipe/p_screen.h"
+#include "util/macros.h"
+#include "util/os_time.h"
+#include "util/u_reclaim.h"
+
+#define CHECK(cond)                                                       \
+   do {                                                                   \
+      if (!(cond)) {                                                      \
+         fprintf(stderr, "%s:%d: %s\n", __FILE__, __LINE__, #cond);       \
+         exit(1);                                                         \
+      }                                                                   \
+   } while (0)
+
+#define MIB (1ull << 20)
+#define MS (1000ll * 1000)
+
+#ifndef U_RECLAIM_FINISH_NS
+#error "this test is built with the times of u_reclaim.c shortened"
+#endif
+
+/* How the fence of each flush answers: it is ready this long after the flush
+ * returned, or never when negative, and the flush takes this long to return.
+ * The submission of the fence and the GPU's work are one delay here: a
+ * driver that waits for each in turn gives each the time it is passed. */
+struct script {
+   int64_t flush_takes_ns[2];
+   int64_t ready_after_ns[2];
+};
+
+static struct {
+   unsigned flushes;
+   unsigned trims;
+   unsigned releases;
+   unsigned polls;
+   int64_t ready_at_ns;
+   uint64_t freed;
+   uint64_t freed_by_release;
+   struct script script;
+} fake;
+
+static int fence_token;
+
+static void
+fake_flush(UNUSED struct pipe_context *pipe, struct pipe_fence_handle **fence,
+           unsigned flags)
+{
+   CHECK(flags & PIPE_FLUSH_ASYNC);
+   const unsigned n = MIN2(fake.flushes, 1);
+
+   fake.flushes++;
+   if (fake.script.flush_takes_ns[n] > 0)
+      os_time_sleep(fake.script.flush_takes_ns[n] / 1000);
+   fake.ready_at_ns = fake.script.ready_after_ns[n] < 0 ?
+                      INT64_MAX :
+                      os_time_get_nano() + fake.script.ready_after_ns[n];
+   if (fence)
+      *fence = (struct pipe_fence_handle *)&fence_token;
+}
+
+static void
+fake_trim(UNUSED struct pipe_context *pipe)
+{
+   fake.trims++;
+}
+
+/* Only ever asked, never waited on: the test refuses a wait, which a driver
+ * could compose of two that each last as long as it is told to. */
+static bool
+fake_fence_finish(UNUSED struct pipe_screen *screen,
+                  UNUSED struct pipe_context *ctx,
+                  UNUSED struct pipe_fence_handle *fence, uint64_t timeout)
+{
+   CHECK(timeout == 0);
+   fake.polls++;
+   return os_time_get_nano() >= fake.ready_at_ns;
+}
+
+static void
+fake_fence_reference(UNUSED struct pipe_screen *screen,
+                     struct pipe_fence_handle **ptr,
+                     struct pipe_fence_handle *fence)
+{
+   *ptr = fence;
+}
+
+static unsigned
+fake_release(UNUSED struct pipe_screen *screen)
+{
+   fake.releases++;
+   fake.freed += fake.freed_by_release;
+   return 1;
+}
+
+static uint64_t
+fake_freed(UNUSED struct pipe_screen *screen)
+{
+   return fake.freed;
+}
+
+/* The state of a reclaim is in the screen and the context: zero is a screen
+ * or a context that has never reclaimed, which is what every driver makes
+ * of them. */
+static struct pipe_screen screens[96];
+static struct pipe_context contexts[256];
+static unsigned screens_used, contexts_used;
+
+static void
+init_screen(struct pipe_screen *screen)
+{
+   memset(screen, 0, sizeof(*screen));
+   screen->fence_finish = fake_fence_finish;
+   screen->fence_reference = fake_fence_reference;
+   screen->release_cached_memory = fake_release;
+   screen->get_freed_memory = fake_freed;
+}
+
+static void
+init_context(struct pipe_context *context, struct pipe_screen *screen)
+{
+   memset(context, 0, sizeof(*context));
+   context->screen = screen;
+   context->flush = fake_flush;
+   context->trim = fake_trim;
+}
+
+static struct pipe_screen *
+new_screen(void)
+{
+   struct pipe_screen *screen = &screens[screens_used++];
+
+   init_screen(screen);
+   return screen;
+}
+
+static struct pipe_context *
+new_context(struct pipe_screen *screen)
+{
+   struct pipe_context *context = &contexts[contexts_used++];
+
+   init_context(context, screen);
+   return context;
+}
+
+static void
+reset(void)
+{
+   memset(&fake, 0, sizeof(fake));
+}
+
+static int64_t
+since(int64_t from_ns)
+{
+   return os_time_get_nano() - from_ns;
+}
+
+static void
+sleep_ns(int64_t ns)
+{
+   os_time_sleep(ns / 1000);
+}
+
+struct begin_in_thread {
+   struct pipe_context *context;
+   struct u_reclaim reclaim;
+   bool began;
+};
+
+static int
+begin_thread(void *data)
+{
+   struct begin_in_thread *begin = data;
+
+   begin->began = u_reclaim_begin(begin->context, true, &begin->reclaim);
+   return 0;
+}
+
+int
+main(void)
+{
+   struct u_reclaim reclaim;
+
+   /* A reclaim finishes the context's work, trims it, finishes again for the
+    * trim, and releases what the screen caches. */
+   {
+      struct pipe_context *a = new_context(new_screen());
+
+      reset();
+      CHECK(u_reclaim_begin(a, true, &reclaim));
+      CHECK(fake.flushes == 2 && fake.polls >= 2 && fake.trims == 1);
+      CHECK(fake.releases == 1);
+      u_reclaim_end(&reclaim, true);
+   }
+
+   /* A call that does not own the context only releases the caches. */
+   {
+      struct pipe_context *a = new_context(new_screen());
+
+      reset();
+      CHECK(u_reclaim_begin(a, false, &reclaim));
+      CHECK(fake.flushes == 0 && fake.polls == 0 && fake.trims == 0);
+      CHECK(fake.releases == 1);
+      u_reclaim_end(&reclaim, true);
+   }
+
+   /* The wait for the room does not touch the context, stops after a short
+    * grace when nothing was freed, and after the time it has when something
+    * was. */
+   {
+      struct pipe_context *a = new_context(new_screen());
+
+      reset();
+      CHECK(u_reclaim_begin(a, true, &reclaim));
+      unsigned flushes = fake.flushes, polls = fake.polls;
+      int64_t from = os_time_get_nano();
+      u_reclaim_settle(&reclaim);
+      CHECK(since(from) >= U_RECLAIM_GRACE_NS - 5 * MS);
+      CHECK(since(from) < U_RECLAIM_SETTLE_NS / 2);
+      CHECK(fake.flushes == flushes && fake.polls == polls);
+      u_reclaim_end(&reclaim, true);
+
+      reset();
+      fake.freed_by_release = 2 * MIB;
+      CHECK(u_reclaim_begin(a, true, &reclaim));
+      flushes = fake.flushes;
+      polls = fake.polls;
+      from = os_time_get_nano();
+      u_reclaim_settle(&reclaim);
+      CHECK(since(from) >= U_RECLAIM_SETTLE_NS * 9 / 10);
+      CHECK(since(from) < U_RECLAIM_SETTLE_NS + 100 * MS);
+      CHECK(fake.flushes == flushes && fake.polls == polls);
+      u_reclaim_end(&reclaim, true);
+   }
+
+   /* A reclaim that did not help rules out another of its context for a
+    * moment, which neither flushes nor waits, and not for longer. */
+   {
+      struct pipe_context *a = new_context(new_screen());
+
+      reset();
+      CHECK(u_reclaim_begin(a, true, &reclaim));
+      u_reclaim_end(&reclaim, false);
+      reset();
+      CHECK(!u_reclaim_begin(a, true, &reclaim));
+      CHECK(fake.flushes == 0 && fake.polls == 0 && fake.releases == 0);
+      sleep_ns(U_RECLAIM_FUTILE_NS + 20 * MS);
+      CHECK(u_reclaim_begin(a, true, &reclaim));
+      u_reclaim_end(&reclaim, true);
+   }
+
+   /* An impossible request in one context does not rule out another's. */
+   {
+      struct pipe_screen *screen = new_screen();
+      struct pipe_context *a = new_context(screen);
+      struct pipe_context *b = new_context(screen);
+
+      reset();
+      CHECK(u_reclaim_begin(a, true, &reclaim));
+      u_reclaim_end(&reclaim, false);
+      CHECK(!u_reclaim_begin(a, true, &reclaim));
+      reset();
+      CHECK(u_reclaim_begin(b, true, &reclaim));
+      CHECK(fake.flushes == 2);
+      u_reclaim_end(&reclaim, true);
+   }
+
+   /* The cooldown of a context is its own however many others have one: no
+    * table of them forgets it. */
+   {
+      struct pipe_screen *screen = new_screen();
+      struct pipe_context *first = new_context(screen);
+
+      reset();
+      CHECK(u_reclaim_begin(first, true, &reclaim));
+      u_reclaim_end(&reclaim, false);
+      for (unsigned i = 0; i < 40; i++) {
+         struct pipe_context *other = new_context(screen);
+
+         CHECK(u_reclaim_begin(other, true, &reclaim));
+         u_reclaim_end(&reclaim, false);
+      }
+      CHECK(!u_reclaim_begin(first, true, &reclaim));
+   }
+
+   /* One reclaim runs on a screen at a time, from its begin to its end: a
+    * context that meets its refusal meanwhile leaves its request refused,
+    * without a flush, however many other screens come and go. */
+   {
+      struct pipe_screen *screen = new_screen();
+      struct pipe_context *a = new_context(screen);
+      struct pipe_context *b = new_context(screen);
+      struct u_reclaim other;
+
+      reset();
+      CHECK(u_reclaim_begin(a, true, &reclaim));
+      reset();
+      CHECK(!u_reclaim_begin(b, true, &other));
+      CHECK(fake.flushes == 0 && fake.polls == 0 && fake.releases == 0);
+      for (unsigned i = 0; i < 12; i++) {
+         struct pipe_screen *more = new_screen();
+         struct u_reclaim there;
+
+         CHECK(u_reclaim_begin(new_context(more), true, &there));
+         u_reclaim_end(&there, true);
+      }
+      CHECK(!u_reclaim_begin(b, true, &other));
+      u_reclaim_end(&reclaim, true);
+      CHECK(u_reclaim_begin(b, true, &other));
+      u_reclaim_end(&other, true);
+   }
+
+   /* A reclaim that holds the screen for longer than anything else in the
+    * helper (its flush is slow, which nothing here bounds) keeps it until it
+    * ends, however long that takes; the end of a reclaim that does not hold
+    * the claim any more gives up nothing and rules nothing out. */
+   {
+      struct pipe_screen *screen = new_screen();
+      struct pipe_context *a = new_context(screen);
+      struct pipe_context *b = new_context(screen);
+      struct pipe_context *c = new_context(screen);
+      struct begin_in_thread slow = {.context = a};
+      thrd_t thread;
+      struct u_reclaim second, third;
+
+      reset();
+      fake.script.flush_takes_ns[0] = 3 * U_RECLAIM_FINISH_NS;
+      CHECK(thrd_create(&thread, begin_thread, &slow) == thrd_success);
+      sleep_ns(U_RECLAIM_FINISH_NS);
+      CHECK(!u_reclaim_begin(b, true, &second));
+      sleep_ns(U_RECLAIM_FINISH_NS);
+      CHECK(!u_reclaim_begin(b, true, &second));
+      CHECK(thrd_join(thread, NULL) == thrd_success);
+      CHECK(slow.began);
+      /* the slow reclaim is made, and still holds the screen */
+      CHECK(!u_reclaim_begin(b, true, &second));
+      const struct u_reclaim stale = slow.reclaim;
+      u_reclaim_end(&slow.reclaim, true);
+      reset();
+      CHECK(u_reclaim_begin(b, true, &second));
+      CHECK(!u_reclaim_begin(c, true, &third));
+      /* the end of the first reclaim again changes nothing: not b's claim,
+       * and not a cooldown of a's context */
+      struct u_reclaim again = stale;
+      u_reclaim_end(&again, false);
+      CHECK(!u_reclaim_begin(c, true, &third));
+      u_reclaim_end(&second, true);
+      CHECK(u_reclaim_begin(a, true, &third));
+      u_reclaim_end(&third, true);
+      /* and an end that never began changes nothing either */
+      struct u_reclaim none;
+      memset(&none, 0, sizeof(none));
+      none.screen = screen;
+      none.pipe = a;
+      CHECK(u_reclaim_begin(c, true, &third));
+      u_reclaim_end(&none, false);
+      CHECK(!u_reclaim_begin(b, true, &second));
+      u_reclaim_end(&third, true);
+   }
+
+   /* Work that does not finish: the wait ends at its bound whatever the
+    * driver's fence does, nothing is trimmed or released, and the screen's
+    * reclaims are ruled out for longer than a failed retry rules one out,
+    * for every context of it, however many other screens come and go; a
+    * second screen is not ruled out. */
+   {
+      struct pipe_screen *screen = new_screen();
+      struct pipe_screen *other = new_screen();
+      struct pipe_context *a = new_context(screen);
+      struct pipe_context *b = new_context(screen);
+      struct pipe_context *c = new_context(other);
+
+      reset();
+      fake.script.ready_after_ns[0] = -1;
+      const int64_t from = os_time_get_nano();
+      CHECK(!u_reclaim_begin(a, true, &reclaim));
+      CHECK(since(from) >= U_RECLAIM_FINISH_NS);
+      CHECK(since(from) < U_RECLAIM_FINISH_NS + 100 * MS);
+      CHECK(fake.flushes == 1 && fake.trims == 0 && fake.releases == 0);
+
+      reset();
+      CHECK(!u_reclaim_begin(b, true, &reclaim));
+      CHECK(fake.flushes == 0 && fake.polls == 0 && fake.releases == 0);
+      CHECK(u_reclaim_begin(c, true, &reclaim));
+      u_reclaim_end(&reclaim, true);
+      for (unsigned i = 0; i < 12; i++) {
+         struct u_reclaim there;
+
+         CHECK(u_reclaim_begin(new_context(new_screen()), true, &there));
+         u_reclaim_end(&there, true);
+      }
+
+      /* the time a failed retry rules out is not enough, the hung one is */
+      sleep_ns(U_RECLAIM_FUTILE_NS + 50 * MS);
+      CHECK(!u_reclaim_begin(b, true, &reclaim));
+      sleep_ns(U_RECLAIM_HUNG_NS + 20 * MS);
+      reset();
+      CHECK(u_reclaim_begin(b, true, &reclaim));
+      u_reclaim_end(&reclaim, true);
+   }
+
+   /* A screen or a context made at the address of one that is gone is a
+    * new one: zero, whatever the old one was ruled out for. */
+   {
+      struct pipe_screen *screen = new_screen();
+      struct pipe_context *a = new_context(screen);
+
+      reset();
+      CHECK(u_reclaim_begin(a, true, &reclaim));
+      u_reclaim_end(&reclaim, false);
+      CHECK(!u_reclaim_begin(a, true, &reclaim));
+      init_context(a, screen);
+      CHECK(u_reclaim_begin(a, true, &reclaim));
+      u_reclaim_end(&reclaim, true);
+
+      reset();
+      fake.script.ready_after_ns[0] = -1;
+      CHECK(!u_reclaim_begin(a, true, &reclaim));
+      reset();
+      CHECK(!u_reclaim_begin(a, true, &reclaim));
+      init_screen(screen);
+      CHECK(u_reclaim_begin(a, true, &reclaim));
+      u_reclaim_end(&reclaim, true);
+   }
+
+   /* A fence that completes its submission late while the GPU is still
+    * pending: the wait still ends at the bound, not at twice it. */
+   {
+      struct pipe_context *a = new_context(new_screen());
+
+      reset();
+      fake.script.ready_after_ns[0] = 3 * U_RECLAIM_FINISH_NS;
+      const int64_t from = os_time_get_nano();
+      CHECK(!u_reclaim_begin(a, true, &reclaim));
+      CHECK(since(from) >= U_RECLAIM_FINISH_NS);
+      CHECK(since(from) < U_RECLAIM_FINISH_NS + 100 * MS);
+      CHECK(fake.polls > 10);
+   }
+
+   /* A fence that is ready only just after the bound does not count, and the
+    * last sleep does not run past the bound. */
+   {
+      struct pipe_context *a = new_context(new_screen());
+
+      reset();
+      fake.script.ready_after_ns[0] = U_RECLAIM_FINISH_NS + 3 * MS;
+      const int64_t from = os_time_get_nano();
+      CHECK(!u_reclaim_begin(a, true, &reclaim));
+      CHECK(since(from) >= U_RECLAIM_FINISH_NS);
+      CHECK(since(from) < U_RECLAIM_FINISH_NS + 50 * MS);
+      CHECK(fake.trims == 0);
+   }
+
+   /* The two waits of a reclaim (before and after the trim) share the time:
+    * each would take 0.6 of it, and the second is out of time. */
+   {
+      struct pipe_context *a = new_context(new_screen());
+
+      reset();
+      fake.script.ready_after_ns[0] = U_RECLAIM_FINISH_NS * 6 / 10;
+      fake.script.ready_after_ns[1] = U_RECLAIM_FINISH_NS * 6 / 10;
+      const int64_t from = os_time_get_nano();
+      CHECK(!u_reclaim_begin(a, true, &reclaim));
+      CHECK(since(from) >= U_RECLAIM_FINISH_NS);
+      CHECK(since(from) < U_RECLAIM_FINISH_NS + 100 * MS);
+      CHECK(fake.flushes == 2 && fake.trims == 1 && fake.releases == 0);
+   }
+
+   /* The bound covers the waiting after the flush returns, not the flush: a
+    * flush that takes a whole bound and a fence that is ready when it
+    * returns make a reclaim. */
+   {
+      struct pipe_context *a = new_context(new_screen());
+
+      reset();
+      fake.script.flush_takes_ns[0] = U_RECLAIM_FINISH_NS;
+      CHECK(u_reclaim_begin(a, true, &reclaim));
+      CHECK(fake.releases == 1);
+      u_reclaim_end(&reclaim, true);
+   }
+
+   printf("u_reclaim: ok\n");
+   return 0;
+}
