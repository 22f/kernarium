diff --git a/src/gallium/include/pipe/p_screen.h b/src/gallium/include/pipe/p_screen.h
index 0645f26e5b1168a7fb57199e5c0acb689b0eb580..471cc259dd22d49787db67ce8c577e6e1a2da73d 100644
--- a/src/gallium/include/pipe/p_screen.h
+++ b/src/gallium/include/pipe/p_screen.h
@@ -659,6 +659,14 @@ struct pipe_screen {
     */
    unsigned (*release_cached_memory)(struct pipe_screen *screen);
 
+   /**
+    * The bytes of device memory the driver has freed since the screen was
+    * created. A caller that reclaims memory for a request the driver
+    * refused compares two readings to see whether the reclaim freed
+    * anything. Optional. May be called from any thread.
+    */
+   uint64_t (*get_freed_memory)(struct pipe_screen *screen);
+
    /**
     * Run driver-specific NIR lowering and optimization passes.
     *
