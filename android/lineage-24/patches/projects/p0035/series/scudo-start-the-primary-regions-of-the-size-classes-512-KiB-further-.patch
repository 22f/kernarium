From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Fri, 20 Nov 2026 09:44:45 +0900
Subject: [PATCH] scudo: start the primary regions of the size classes 512 KiB
 further apart

The primary allocator reserves one region of 2^28 bytes per size class
back to back, so, whatever each region's random start page, the first
blocks of every class sit at the same few offsets of every larger power
of two. A direct-mapped cache of addresses that is indexed by a range of
page-number bits, such as the software TLB of an emulator, then maps the
hot blocks of different classes to the same slots and evicts them at
every access of a loop. Each region now also starts ClassId times 512 KiB
past its base, which puts the first blocks of up to 128 classes in
different slots of an index of 14 page-number bits.

The new optional primary option RegionClassOffset (default 0) holds the
step; only the 64-bit Android configurations set it, and a static_assert
keeps all the offsets within an eighth of a region. The offset is part of
RegionBeg, so the existing check that the mapped range ends within the
region already accounts for it, and the existing random page offset is
kept. An application sees different addresses, and each class's region
now holds up to 16 MiB less: the class in the last slot maps 239.75 MiB
instead of 255.75 MiB before its allocations fall back to a larger class
and then to the secondary, so a process that holds about 240 MB in one
size class reaches the secondary earlier. The 32-bit configuration uses
the 32-bit primary and is not touched.
---
 config/custom_scudo_config.h    |  4 ++++
 standalone/allocator_config.def |  8 ++++++++
 standalone/primary64.h          | 12 ++++++++++++
 3 files changed, 24 insertions(+)

diff --git a/config/custom_scudo_config.h b/config/custom_scudo_config.h
index 0cf08516201a2cccd439aee0770a6bf50501ec61..5ccaa16b226681ba1460fb7e68309b5e175363e4 100644
--- a/config/custom_scudo_config.h
+++ b/config/custom_scudo_config.h
@@ -167,6 +167,8 @@ struct AndroidNormalConfig {
     static const uptr CompactPtrScale = SCUDO_MIN_ALIGNMENT_LOG;
     static const uptr GroupSizeLog = 20U;
     static const bool EnableRandomOffset = true;
+    // Start the regions 512 KiB further apart than their size.
+    static const uptr RegionClassOffset = 1UL << 19;
     static const uptr MapSizeIncrement = 1UL << 18;
 #else
     static const uptr RegionSizeLog = 18U;
@@ -227,6 +229,8 @@ struct AndroidLowMemoryConfig {
     static const uptr CompactPtrScale = SCUDO_MIN_ALIGNMENT_LOG;
     static const uptr GroupSizeLog = 18U;
     static const bool EnableRandomOffset = true;
+    // Start the regions 512 KiB further apart than their size.
+    static const uptr RegionClassOffset = 1UL << 19;
     static const uptr MapSizeIncrement = 1UL << 18;
 #else
     static const uptr RegionSizeLog = 20U;
diff --git a/standalone/allocator_config.def b/standalone/allocator_config.def
index e579a021db6c94a1ba0b888298484f2b25aba071..61bbe2bcb361f9b171263bf5bedf86fe15f24ad2 100644
--- a/standalone/allocator_config.def
+++ b/standalone/allocator_config.def
@@ -126,6 +126,14 @@ PRIMARY_OPTIONAL(const uptr, CompactPtrScale, SCUDO_MIN_ALIGNMENT_LOG)
 PRIMARY_OPTIONAL(const bool, EnableRandomOffset, false)
 PRIMARY_OPTIONAL(const s32, DefaultReleaseToOsIntervalMs, INT32_MIN)
 
+// Starts the region of each size class `ClassId * RegionClassOffset` bytes
+// after the start the region would otherwise have, so that the regions, which
+// are `2^RegionSizeLog` bytes apart, do not begin at the same offset of a
+// larger power of two. The value must be a multiple of the page size and
+// `NumClasses * RegionClassOffset` must stay well below the region size. Zero
+// disables it. This is only used if `EnableContiguousRegions` is enabled.
+PRIMARY_OPTIONAL(const uptr, RegionClassOffset, 0)
+
 // When `EnableContiguousRegions` is true, all regions will be be arranged in
 // adjacency. This will reduce the fragmentation caused by region allocations
 // but may require a huge amount of contiguous pages at initialization.
diff --git a/standalone/primary64.h b/standalone/primary64.h
index a185d497e49633804869f7483494beb9a1fe5c3d..7fbce5ba3cacfc369dc126c4a9568252be7f70ee 100644
--- a/standalone/primary64.h
+++ b/standalone/primary64.h
@@ -146,6 +146,8 @@ private:
   static const uptr RegionSize = 1UL << RegionSizeLog;
   static const uptr NumClasses = SizeClassMap::NumClasses;
   static const uptr MapSizeIncrement = Config::getMapSizeIncrement();
+  static_assert(NumClasses * Config::getRegionClassOffset() <= RegionSize / 8,
+                "The class offsets should leave most of each region usable");
   // Fill at most this number of batches from the newly map'd memory.
   static const u32 MaxNumBatches = SCUDO_ANDROID ? 4U : 8U;
 
@@ -391,6 +393,16 @@ void SizeClassAllocator64<Config>::initRegion(RegionInfo *Region, uptr ClassId,
   if (EnableRandomOffset) {
     Region->RegionBeg += (getRandomModN(&Region->RandState, 16) + 1) * PageSize;
   }
+  // With contiguous regions, `ClassId` is the position of the region in the
+  // reservation here, because the regions are only shuffled afterwards. The
+  // regions are a power of two apart, so without this the first blocks of all
+  // the classes would sit at the same few offsets of every larger power of two.
+  // Direct-mapped caches of addresses indexed by a range of page-number bits
+  // (the software TLB of an emulator, for one) then map them to the same slot
+  // and evict each other. The usable range of the region is bounded by
+  // `RegionBeg - MemMap.getBase()`, so the offset also shortens it.
+  if (Config::getEnableContiguousRegions())
+    Region->RegionBeg += ClassId * Config::getRegionClassOffset();
 
   const uptr BlockSize = getSizeByClassId(ClassId);
   // Releasing small blocks is expensive, set a higher threshold to avoid
