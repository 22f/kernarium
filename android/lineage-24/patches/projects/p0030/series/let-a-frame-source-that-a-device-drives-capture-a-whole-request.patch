+/*
+ * The controls of a request that only a source driven by a device outside the
+ * HAL uses; see IFrameSource::IsHostDriven().
+ */
+struct HostSettings {
+  uint8_t ae_mode = ANDROID_CONTROL_AE_MODE_ON;
+  bool ae_lock = false;
+  int32_t ae_compensation = 0;
+  uint8_t ae_precapture_trigger = ANDROID_CONTROL_AE_PRECAPTURE_TRIGGER_IDLE;
+  uint8_t af_mode = ANDROID_CONTROL_AF_MODE_OFF;
+  uint8_t af_trigger = ANDROID_CONTROL_AF_TRIGGER_IDLE;
+  float focus_distance = 0.f;
+  uint8_t awb_mode = ANDROID_CONTROL_AWB_MODE_AUTO;
+  bool awb_lock = false;
+  float color_correction_gains[4] = {1.f, 1.f, 1.f, 1.f};
+  uint8_t flash_mode = ANDROID_FLASH_MODE_OFF;
+  uint8_t jpeg_quality = 90;
+  // Metering and focus regions as (left, top, right, bottom, weight) of the
+  // active array, the first one of the request.
+  int32_t ae_regions[5] = {0, 0, 0, 0, 0};
+  int32_t af_regions[5] = {0, 0, 0, 0, 0};
+};
+
 /*
  * Physical camera settings control
  */
@@ -144,6 +167,7 @@ struct SensorSettings {
   uint32_t test_pattern_data[4] = {0, 0, 0, 0};
   uint32_t screen_rotation = 0;
   uint32_t timestamp_source = ANDROID_SENSOR_INFO_TIMESTAMP_SOURCE_UNKNOWN;
+  HostSettings host;
 };
 
 // Maps physical and logical camera ids to individual device settings
