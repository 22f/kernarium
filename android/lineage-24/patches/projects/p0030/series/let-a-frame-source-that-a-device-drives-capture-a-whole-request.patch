+// What a frame source driven by a device outside the HAL needs from a request
+// beyond the sensor settings: the modes and triggers as the request gave them.
+static void FillHostSettings(const HalCameraMetadata& request,
+                             const EmulatedCameraDeviceInfo& info,
+                             HostSettings* host) {
+  camera_metadata_ro_entry_t entry;
+  const bool control_off = info.control_mode_ == ANDROID_CONTROL_MODE_OFF;
+  host->ae_mode = control_off ? ANDROID_CONTROL_AE_MODE_OFF : info.ae_mode_;
+  host->af_mode = control_off ? ANDROID_CONTROL_AF_MODE_OFF : info.af_mode_;
+  host->awb_mode = control_off ? ANDROID_CONTROL_AWB_MODE_OFF : info.awb_mode_;
+  host->ae_lock = info.ae_lock_ == ANDROID_CONTROL_AE_LOCK_ON;
+  host->awb_lock = info.awb_lock_ == ANDROID_CONTROL_AWB_LOCK_ON;
+  host->ae_compensation = info.exposure_compensation_;
+  host->focus_distance = info.focus_distance_;
+
+  host->ae_precapture_trigger = ANDROID_CONTROL_AE_PRECAPTURE_TRIGGER_IDLE;
+  if ((request.Get(ANDROID_CONTROL_AE_PRECAPTURE_TRIGGER, &entry) == OK) &&
+      (entry.count == 1)) {
+    host->ae_precapture_trigger = entry.data.u8[0];
+  }
+  host->af_trigger = ANDROID_CONTROL_AF_TRIGGER_IDLE;
+  if ((request.Get(ANDROID_CONTROL_AF_TRIGGER, &entry) == OK) && (entry.count == 1)) {
+    host->af_trigger = entry.data.u8[0];
+  }
+  if ((request.Get(ANDROID_COLOR_CORRECTION_GAINS, &entry) == OK) && (entry.count == 4)) {
+    for (size_t i = 0; i < 4; ++i) {
+      host->color_correction_gains[i] = entry.data.f[i];
+    }
+  }
+  if ((request.Get(ANDROID_FLASH_MODE, &entry) == OK) && (entry.count == 1)) {
+    host->flash_mode = entry.data.u8[0];
+  }
+  if ((request.Get(ANDROID_JPEG_QUALITY, &entry) == OK) && (entry.count == 1)) {
+    host->jpeg_quality = entry.data.u8[0];
+  }
+  memcpy(host->ae_regions, info.ae_metering_region_, sizeof(host->ae_regions));
+  memcpy(host->af_regions, info.af_metering_region_, sizeof(host->af_regions));
+}
+
 status_t EmulatedRequestState::InitializeSensorSettings(
     std::unique_ptr<HalCameraMetadata> request_settings,
     uint32_t override_frame_number,
@@ -920,6 +959,7 @@ status_t EmulatedRequestState::InitializeSensorSettings(
   sensor_settings->timestamp_source = info.timestamp_source_;
   memcpy(sensor_settings->test_pattern_data, test_pattern_data,
          sizeof(sensor_settings->test_pattern_data));
+  FillHostSettings(*request_settings_, info, &sensor_settings->host);
 
   return OK;
 }
