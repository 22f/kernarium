+#include "system/graphics-base-v1.1.h"
+#define LOG_TAG "EmulatedSensorHost"
+#define ATRACE_TAG ATRACE_TAG_CAMERA
+
+#include <inttypes.h>
+#include <log/log.h>
+#include <system/camera_metadata.h>
+#include <utils/Trace.h>
+
+#include "EmulatedSensor.h"
+
+namespace android {
+
+using google_camera_hal::BufferStatus;
+using google_camera_hal::HalCameraMetadata;
+using google_camera_hal::NotifyMessage;
+using google_camera_hal::ShutterMessage;
+
+void EmulatedSensor::CaptureFromHost(
+    const LogicalCameraSettings& settings, Buffers* buffers,
+    HwlPipelineResult* result, const HwlPipelineCallback& callback,
+    const std::vector<StreamGroupState>& stream_group_state,
+    uint32_t frame_number) {
+  ATRACE_CALL();
+  if (buffers == nullptr || buffers->empty()) {
+    return;
+  }
+  const uint32_t pipeline_id =
+      result != nullptr ? result->pipeline_id : buffers->at(0)->pipeline_id;
+  HalCameraMetadata* metadata =
+      result != nullptr ? result->result_metadata.get() : nullptr;
+
+  uint32_t timestamp_source = ANDROID_SENSOR_INFO_TIMESTAMP_SOURCE_UNKNOWN;
+  nsecs_t exposure_time = kSupportedExposureTimeRange[0];
+  if (!settings.empty()) {
+    timestamp_source = settings.begin()->second.timestamp_source;
+    exposure_time = settings.begin()->second.exposure_time;
+  }
+
+  // The whole request is queued before any of it is collected, so that all of
+  // its streams are one exposure. A buffer that could not be queued has been
+  // marked as failed.
+  const status_t queued = frame_source_->BeginRequest(settings, buffers);
+  if (queued != OK) {
+    ALOGW("%s: frame %u was not queued completely (%d)", __FUNCTION__,
+          frame_number, queued);
+  }
+
+  for (auto& buffer : *buffers) {
+    if (buffer->is_input ||
+        buffer->stream_buffer.status == BufferStatus::kError) {
+      continue;
+    }
+    auto device_settings = settings.find(buffer->camera_id);
+    auto device_chars = chars_->find(buffer->camera_id);
+    if (device_settings == settings.end() || device_chars == chars_->end()) {
+      ALOGE("%s: Sensor settings or characteristics absent for device: %u",
+            __FUNCTION__, buffer->camera_id);
+      buffer->stream_buffer.status = BufferStatus::kError;
+      continue;
+    }
+
+    buffer->stream_buffer.status = BufferStatus::kOk;
+    status_t ret = BAD_VALUE;
+    if (buffer->format == PixelFormat::BLOB) {
+      if (buffer->dataSpace == HAL_DATASPACE_V0_JFIF && metadata != nullptr) {
+        ret = frame_source_->ProduceBlob(buffer->camera_id,
+                                         device_settings->second, buffer.get(),
+                                         metadata, device_chars->second);
+      } else {
+        ALOGE("%s: Dataspace %x of a BLOB is not a JPEG", __FUNCTION__,
+              buffer->dataSpace);
+      }
+    } else {
+      ret = frame_source_->ProduceFrame(buffer->camera_id, 0 /*timestamp*/,
+                                        device_settings->second, buffer.get(),
+                                        nullptr /*input_buffer*/);
+    }
+    if (ret != OK) {
+      buffer->stream_buffer.status = BufferStatus::kError;
+    }
+  }
+
+  // The frame time and the exposure's own values come from the device; without
+  // them (every buffer failed) the time is now.
+  nsecs_t frame_time = getSystemTimeWithSource(timestamp_source);
+  if (metadata != nullptr) {
+    frame_source_->FrameResult(logical_camera_id_, metadata, &frame_time);
+    camera_metadata_ro_entry_t entry;
+    if ((metadata->Get(ANDROID_SENSOR_EXPOSURE_TIME, &entry) == OK) &&
+        (entry.count == 1)) {
+      exposure_time = entry.data.i64[0];
+    }
+  }
+  next_capture_time_ = frame_time;
+  next_readout_time_ = frame_time + exposure_time;
+
+  // The shutter message precedes every buffer; the buffers go back to the
+  // framework when they are destroyed.
+  if (callback.notify != nullptr) {
+    NotifyMessage msg = ShutterMessage{
+        .frame_number = frame_number,
+        .timestamp_ns = static_cast<uint64_t>(next_capture_time_),
+        .readout_timestamp_ns = static_cast<uint64_t>(next_readout_time_),
+        .stream_group_state = stream_group_state};
+    callback.notify(pipeline_id, msg);
+  }
+  if (callback.notify_override_pending_buffer != nullptr &&
+      stream_group_state.size() > 0) {
+    callback.notify_override_pending_buffer(frame_number, stream_group_state);
+  }
+  buffers->clear();
+}
+
+}  // namespace android
diff --git a/devices/EmulatedCamera/hwl/IFrameSource.h b/devices/EmulatedCamera/hwl/IFrameSource.h
index a0f4d30206ae132f8594375203a44b50e66d1b73..cce7bf68ecaa1df4fc4a1bba34dc812169c32304 100644
--- a/devices/EmulatedCamera/hwl/IFrameSource.h
+++ b/devices/EmulatedCamera/hwl/IFrameSource.h
@@ -54,6 +54,44 @@ class IFrameSource {
   virtual void CalculateAndAppendNoiseProfile(
       float gain /*in ISO*/, float max_raw_value,
       HalCameraMetadata* result /*out*/) = 0;
+
+  // A source that is driven by a device outside the HAL captures by itself.
+  // For such a request the sensor calls BeginRequest once, which queues every
+  // output buffer of the request and applies the request's controls. It then
+  // collects each buffer, with ProduceFrame or, for a JPEG, ProduceBlob,
+  // takes the frame time and the exposure's metadata from FrameResult, and
+  // sends the shutter message itself.
+  virtual bool IsHostDriven() const {
+    return false;
+  }
+
+  virtual status_t BeginRequest(const LogicalCameraSettings& /*settings*/,
+                                Buffers* /*buffers*/) {
+    return INVALID_OPERATION;
+  }
+
+  // Collects a JPEG into `buffer`: the picture, its Exif data built from the
+  // result's metadata, and the trailing blob header.
+  virtual status_t ProduceBlob(uint32_t /*camera_id*/,
+                               const SensorSettings& /*settings*/,
+                               SensorBuffer* /*buffer*/,
+                               HalCameraMetadata* /*result_metadata*/,
+                               const SensorCharacteristics& /*chars*/) {
+    return INVALID_OPERATION;
+  }
+
+  // Replaces the values of the result's keys that the exposure determined, and
+  // reports the frame time (CLOCK_BOOTTIME) of the request's first buffer.
+  virtual bool FrameResult(uint32_t /*camera_id*/, HalCameraMetadata* /*result*/,
+                           nsecs_t* /*timestamp*/) {
+    return false;
+  }
+
+  // Adds the neutral color point that the last still measured, if there is one.
+  virtual bool AppendNeutralColorPoint(uint32_t /*camera_id*/,
+                                       HalCameraMetadata* /*result*/) {
+    return false;
+  }
 };
 
 }  // namespace framesource
