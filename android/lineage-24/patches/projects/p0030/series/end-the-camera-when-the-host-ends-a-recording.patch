From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 15 Nov 2026 16:19:18 +0900
Subject: [PATCH] end the camera when the host ends a recording

When the application leaves the foreground the host ends the video of a
camera that records: it fails the camera's video buffers under a black,
interrupted record and keeps doing so until the guest closes the stream.
The HAL passed those buffers on as failed buffers, which an application
cannot tell from a hiccup, and the recording went on, dark, for as long
as the application stayed away.

- A video buffer that fails while the camera's newest record is black
  and interrupted marks the source as lost (camera_lost, the rule the
  host's wire contract states).
- The sensor then fails the request as a whole, as before, but reports
  ERROR_DEVICE for it instead of a request error. The camera framework
  treats the device as gone, the application closes the camera, and the
  clip it was recording is finalized and saved.
- A failed buffer without that record keeps its old meaning.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 .../EmulatedCamera/hwl/EmulatedSensorHost.cpp | 22 ++++++++++++++-----
 devices/EmulatedCamera/hwl/IFrameSource.h     | 10 +++++++++
 .../EmulatedCamera/hwl/V4l2FrameSource.cpp    | 17 ++++++++++++++
 devices/EmulatedCamera/hwl/V4l2FrameSource.h  |  6 +++++
 4 files changed, 49 insertions(+), 6 deletions(-)

diff --git a/devices/EmulatedCamera/hwl/EmulatedSensorHost.cpp b/devices/EmulatedCamera/hwl/EmulatedSensorHost.cpp
index d2105c09f0f31cfa7a0c73f1c423c0756df17431..ae6647564f1f28a3206e527af9739cc486d2c9ac 100644
--- a/devices/EmulatedCamera/hwl/EmulatedSensorHost.cpp
+++ b/devices/EmulatedCamera/hwl/EmulatedSensorHost.cpp
@@ -134,18 +134,28 @@ void EmulatedSensor::CaptureFromHost(
       ++failed;
     }
   }
-  if (frame_source_->FailsRequest(outputs, failed)) {
-    ALOGW("%s: frame %u failed: none of its %zu outputs was produced",
-          __FUNCTION__, frame_number, outputs);
+  // A camera the host has ended fails the request whatever else was produced, and the
+  // framework is told that the device is gone (ERROR_DEVICE), not that one request failed:
+  // only that makes an application close the camera, which ends a recording it holds and
+  // saves the clip.
+  const bool device_lost = frame_source_->DeviceLost();
+  if (device_lost || frame_source_->FailsRequest(outputs, failed)) {
+    if (device_lost) {
+      ALOGW("%s: frame %u failed: the host ended the camera", __FUNCTION__, frame_number);
+    } else {
+      ALOGW("%s: frame %u failed: none of its %zu outputs was produced",
+            __FUNCTION__, frame_number, outputs);
+    }
     for (auto& buffer : *buffers) {
       buffer->is_failed_request = true;
     }
     next_capture_time_ = getSystemTimeWithSource(timestamp_source);
     next_readout_time_ = next_capture_time_ + exposure_time;
     if (callback.notify != nullptr) {
-      NotifyMessage msg = ErrorMessage{.frame_number = frame_number,
-                                       .error_stream_id = -1,
-                                       .error_code = ErrorCode::kErrorRequest};
+      NotifyMessage msg = ErrorMessage{
+          .frame_number = frame_number,
+          .error_stream_id = -1,
+          .error_code = device_lost ? ErrorCode::kErrorDevice : ErrorCode::kErrorRequest};
       callback.notify(pipeline_id, msg);
     }
     if (result != nullptr) {
diff --git a/devices/EmulatedCamera/hwl/IFrameSource.h b/devices/EmulatedCamera/hwl/IFrameSource.h
index cea72f2711ef850a568d7fc8830a4414dc430326..99cdcfb3865934cc3ea83cad30cea25a0237dc13 100644
--- a/devices/EmulatedCamera/hwl/IFrameSource.h
+++ b/devices/EmulatedCamera/hwl/IFrameSource.h
@@ -80,6 +80,16 @@ class IFrameSource {
     return false;
   }
 
+  // Whether the device behind the source has ended the camera: the host took
+  // it away and says so (the application left the foreground while a recording
+  // ran). The sensor then fails the request as a whole and tells the framework
+  // ERROR_DEVICE, which an application answers by closing the camera, and a
+  // recording it holds is saved. Once true it stays true for the source, which
+  // lives as long as the camera session; a session opened afterwards is a new one.
+  virtual bool DeviceLost() const {
+    return false;
+  }
+
   // Collects a JPEG into `buffer`: the picture, its Exif data built from the
   // result's metadata, and the trailing blob header.
   virtual status_t ProduceBlob(uint32_t /*camera_id*/,
diff --git a/devices/EmulatedCamera/hwl/V4l2FrameSource.cpp b/devices/EmulatedCamera/hwl/V4l2FrameSource.cpp
index a8abb58cc4209beb6a2539b77019f402046b4831..76ac043bd6df564ea56d49eab7ac90174bdcf0cd 100644
--- a/devices/EmulatedCamera/hwl/V4l2FrameSource.cpp
+++ b/devices/EmulatedCamera/hwl/V4l2FrameSource.cpp
@@ -565,6 +565,22 @@ bool V4l2FrameSource::MetaOf(Camera* camera, uint64_t sequence, abi::Meta* meta)
   return camera->meta->Latest(meta);
 }
 
+// A video buffer that failed under a black, interrupted record is the host's end of the camera (the host fails the
+// buffers of a video it ended, and records them so); any other failed buffer is a failed buffer. The loss is told to
+// the framework by the sensor (EmulatedSensor::CaptureFromHost).
+void V4l2FrameSource::NoteFailedBuffer(Camera* camera, const V4l2Stream& stream) {
+  abi::Meta latest{};
+  const bool has_record = camera->meta != nullptr && camera->meta->Latest(&latest);
+  if (!andarium::camera::camera_lost(stream.params().kind == V4l2Stream::Kind::kVideo, true,
+                                     has_record, has_record ? latest.flags : 0)) {
+    return;
+  }
+  if (!device_lost_.exchange(true)) {
+    ALOGW("%s: the host ended the camera: its video buffers fail under an interrupted record (flags %x)",
+          __FUNCTION__, static_cast<unsigned>(latest.flags));
+  }
+}
+
 bool V4l2FrameSource::WaitFor(const SensorBuffer* buffer, V4l2Stream::Completion* completion,
                               const uint8_t** mapped, Pending* pending) {
   auto found = pending_.find(buffer);
@@ -604,6 +620,7 @@ status_t V4l2FrameSource::ProduceFrame(uint32_t camera_id, nsecs_t /*timestamp*/
     return BAD_VALUE;
   }
   if (completion.error) {
+    NoteFailedBuffer(camera, *pending.stream);
     return UNKNOWN_ERROR;
   }
   if (camera->request_timestamp == 0) {
diff --git a/devices/EmulatedCamera/hwl/V4l2FrameSource.h b/devices/EmulatedCamera/hwl/V4l2FrameSource.h
index 715b9241d8e7a547a69ee3abf3e07391c448e75e..244dd3b15a64ac64c2d73bbd33c75782b90881ff 100644
--- a/devices/EmulatedCamera/hwl/V4l2FrameSource.h
+++ b/devices/EmulatedCamera/hwl/V4l2FrameSource.h
@@ -64,6 +64,9 @@ class V4l2FrameSource : public IFrameSource {
   }
   status_t BeginRequest(const LogicalCameraSettings& settings, Buffers* buffers) override;
   bool FailsRequest(size_t outputs, size_t failed) const override;
+  bool DeviceLost() const override {
+    return device_lost_;
+  }
   status_t ProduceBlob(uint32_t camera_id, const SensorSettings& settings,
                        SensorBuffer* buffer, HalCameraMetadata* result_metadata,
                        const SensorCharacteristics& chars) override;
@@ -158,6 +161,7 @@ class V4l2FrameSource : public IFrameSource {
                          SensorBuffer* buffer, HalCameraMetadata* result_metadata,
                          const SensorCharacteristics& chars);
   bool MetaOf(Camera* camera, uint64_t sequence, andarium::camera::abi::Meta* meta);
+  void NoteFailedBuffer(Camera* camera, const v4l2cam::V4l2Stream& stream);
   static andarium::camera::Request RequestOf(const SensorSettings& settings);
 
   std::map<uint32_t, Camera> cameras_;
@@ -169,6 +173,8 @@ class V4l2FrameSource : public IFrameSource {
   uint64_t still_free_requests_begun_ = 0;
   // A flush or a close is under way (Interrupt); the sensor clears it as it takes the next request.
   std::atomic<bool> interrupted_{false};
+  // The host ended a camera (NoteFailedBuffer): its video buffers fail under an interrupted record.
+  std::atomic<bool> device_lost_{false};
   // When the request being collected has to be complete, whatever its buffers
   // wait for: one deadline for the whole request.
   andarium::camera::RequestClock request_clock_;
