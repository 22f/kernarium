<resources>
    <!-- Each back lens of the host is its own camera device (ID 2 wide, 3 ultra wide, 4 telephoto)
         beside the zoom camera "0", which zooms across the lenses on its own. The lens buttons open
         the lens cameras, which have manual control. The wide lens is the zoom camera's 1x, so its
         button comes from "0" and the lens camera "2" stays out of the list. A host that lacks a
         lens has no camera for it. -->
    <bool name="config_enableAuxCameras">true</bool>
    <string-array name="config_ignoredAuxCameraIds">
        <item>2</item>
    </string-array>
</resources>
