// SPDX-License-Identifier: Apache-2.0
package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Delivers a text message the host application sends, as the radio stack
// would deliver one from the network. It runs as the system user, which alone
// may send the protected SMS broadcasts, and takes messages only from the adb
// shell (InjectProvider).
android_app {
    name: "KernariumSms",
    manifest: "AndroidManifest.xml",
    srcs: ["src/**/*.java"],
    platform_apis: true,
    certificate: "platform",
    system_ext_specific: true,
    optimize: { enabled: false },
}
