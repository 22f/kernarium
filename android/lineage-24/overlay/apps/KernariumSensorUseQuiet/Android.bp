package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// The activity the sensor privacy service starts, instead of SystemUI's "Unblock"
// dialog, when an application uses a sensor that a hardware switch blocks (the
// framework overlay names it in config_sensorUseStartedActivity_hwToggle). It
// shows nothing. It is a platform application only because the product
// partition's applications are signed with the platform key; it holds no
// permission and starts no service.
android_app {
    name: "KernariumSensorUseQuiet",
    manifest: "AndroidManifest.xml",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    sdk_version: "current",
    certificate: "platform",
    product_specific: true,
    optimize: {
        enabled: false,
    },
}
