{
  "sourceLanguage" : "en",
  "strings" : {
    "Browse the virtual machine’s internal storage, and import or export files and folders." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仮想マシンの内部ストレージを閲覧し、ファイルやフォルダを読み込んだり書き出したりできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浏览虚拟机的内部存储空间，并导入或导出文件和文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "瀏覽虛擬機器的內部儲存空間，並輸入或輸出檔案和檔案夾。"
          }
        }
      }
    },
    "File browser" : {
