  "strings" : {
    "Browse the guest’s internal storage, and import or export files and folders." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲストの内部ストレージを閲覧し、ファイルやフォルダを読み込んだり書き出したりできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
