{
  "sourceLanguage" : "en",
  "strings" : {
    "A tip is a voluntary one-time purchase that supports Andarium’s independent development. Every feature is free either way." : {
      "comment" : "The plain statement under the chat, as a centred note. It must say that a tip is voluntary, one-time and a purchase, and that every feature is free whether or not someone tips.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tip is a voluntary one-time purchase that supports Andarium’s independent development. Every feature is free either way."
          }
        }
      }
    },
    "A voluntary tip for Andarium’s developer." : {
      "comment" : "VoiceOver hint of the Buy me tokens menu item.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A voluntary tip for Andarium’s developer."
          }
        }
      }
    },
