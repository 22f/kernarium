        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andarium無法打開郵件撰寫視窗。"
          }
        }
      }
    },
    "Attached" : {
      "comment" : "What VoiceOver says for the Bug report button once a bug report is attached.",
