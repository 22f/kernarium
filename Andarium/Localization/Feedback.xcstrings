{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ · %@" : {
      "comment" : "The count and the total size of the attachments: 2 attachments · 3.4 MiB.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%@ · %@. Some mail services refuse mail over 20 MiB." : {
      "comment" : "The same line when the attachments are over 20 MiB: the count, the total size and the warning.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@。20 MiBを超えるメールを受け付けないメールサービスがあります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@。部分邮件服务会拒收超过20 MiB的邮件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@。部分郵件服務會拒收超過20 MiB的郵件。"
          }
        }
      }
    },
    "%lld items weren’t added" : {
      "comment" : "The title of the alert when two or more chosen items could not be copied; the number is at least 2.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld件の項目を追加できませんでした"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有%lld个项目未添加"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有%lld個項目未加入"
          }
        }
      }
    },
    "^[%lld attachment](inflect: true)" : {
      "comment" : "The count of attached files under the rows of the mail, and its VoiceOver reading. English agrees the noun with the number; Chinese and Japanese have one form.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添付ファイル%lld件"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld个附件"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld個附件"
          }
        }
      }
    },
    "^[%lld second](inflect: true)" : {
      "comment" : "The length of an attached video as VoiceOver reads it. English agrees the noun with the number; Chinese and Japanese have one form.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld秒"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld秒"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld秒"
          }
        }
      }
    },
    "A bug report and a screenshot need the virtual machine running." : {
      "comment" : "The line under that title.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バグレポートとスクリーンショットには、仮想マシンの実行が必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "错误报告和截屏需要虚拟机处于运行状态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "錯誤報告和截圖需要虛擬機器處於執行狀態。"
          }
        }
      }
    },
    "Add photos or videos" : {
      "comment" : "What VoiceOver says for the Photos button.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真またはビデオを追加"
          }
