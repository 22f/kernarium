    "Problem" : {
      "comment" : "The label of the first line of the mail, which becomes its subject: a short name for what went wrong. iOS's own feedback form says Problem.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "問題"
