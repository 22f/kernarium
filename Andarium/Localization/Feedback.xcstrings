          "stringUnit" : {
            "state" : "translated",
            "value" : "詳細資訊"
          }
        }
      }
    },
    "Discard" : {
      "comment" : "The destructive button of that alert.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "破棄"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放弃"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "捨棄"
          }
        }
      }
    },
    "Discard this feedback?" : {
      "comment" : "The question of the alert that Cancel shows once something is written or attached.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このフィードバックを破棄しますか？"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要放弃此反馈吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要捨棄此使用者意見嗎？"
          }
        }
      }
    },
    "Dismiss" : {
      "comment" : "VoiceOver name of the button that puts away the card that asks for a bug report.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "閉じる"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉"
          }
        }
      }
    },
    "Feedback is sent with the Mail app. Add a mail account in Settings › Apps › Mail › Mail Accounts, then come back." : {
      "comment" : "The text of that notice. The path is iOS's: Settings, Apps, Mail, Mail Accounts, each in iOS's own words for the language.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィードバックは“メール”アプリから送信されます。“設定”＞“アプリ”＞“メール”＞“メールアカウント”でメールアカウントを追加してから、ここに戻ってください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "反馈会通过“邮件”App发送。请在“设置”>“App”>“邮件”>“邮件账户”中添加邮件账户，然后返回此处。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用者意見會透過「郵件」App傳送。請在「設定」>「App」>「郵件」>「郵件帳號」中加入郵件帳號，然後再回到這裡。"
          }
        }
      }
    },
    "Feedback not sent" : {
      "comment" : "The title of the alert when the system's mail composer reports a failure; the system's own words follow.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィードバックを送信できませんでした"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未发送反馈"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未傳送使用者意見"
          }
        }
      }
    },
    "Feedback sent" : {
      "comment" : "The title of the confirmation that shows after the mail was sent.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィードバックを送信しました"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "反馈已发送"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已傳送使用者意見"
          }
        }
      }
    },
    "For any bug, attach a bug report. It tells us what the virtual machine and the app were doing." : {
      "comment" : "The card over the bar while the virtual machine runs. The app is Andarium, an iOS app.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不具合がある場合は、バグレポートを添付してください。仮想マシンとアプリがそのとき何をしていたかがわかります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遇到任何错误时，请附上错误报告。它会告诉我们虚拟机和App当时在做什么。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遇到任何錯誤時，請附上錯誤報告。它會告訴我們虛擬機器和App當時在做什麼。"
          }
        }
      }
    },
    "Hide" : {
      "comment" : "The button under the folded information block that closes it.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非表示"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隱藏"
          }
        }
      }
    },
    "Hide app and device details" : {
      "comment" : "What VoiceOver says for the Hide button: the block at the end of the mail names the app, the iPhone or iPad and the Android version.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリとデバイスの詳細を非表示"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏App和设备详细信息"
