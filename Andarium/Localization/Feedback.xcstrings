            "value" : "未附加錯誤報告"
          }
        }
      }
    },
    "Cancel" : {
      "comment" : "The button at the top of the sheet that closes it; with something written it asks first.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャンセル"
          }
        },
        "zh-Hans" : {
