        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隱藏App和裝置詳細資訊"
          }
        }
      }
    },
    "It couldn’t be copied. Check the free space on this %@, then try again." : {
      "comment" : "The text of that alert. The %@ is iPhone or iPad.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コピーできませんでした。この%@の空き容量を確認して、もう一度お試しください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法拷贝该项目。请检查此%@的可用空间，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法拷貝該項目。請檢查此%@的可用空間，然後再試一次。"
          }
        }
      }
    },
    "Keep editing" : {
