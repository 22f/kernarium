          }
        }
      }
    },
    "This device has %@ of free space left and %@ could not be paused. Shut it down before the space runs out, or free up space and check again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスの空き容量は残り%1$@で、%2$@を一時停止できませんでした。空き容量がなくなる前にシャットダウンするか、空き容量を確保してからもう一度確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备仅剩%1$@可用空间，%2$@无法暂停。请在空间用尽前将其关机，或释放空间后重新检查。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置僅剩%1$@可用空間，%2$@無法暫停。請在空間用盡前將其關機，或釋出空間後重新檢查。"
          }
        }
      }
    },
    "This device has %@ of free space left, too little for %@ to keep writing. Free up space, then resume. %@ needs %@ free to continue." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスの空き容量は残り%1$@で、%2$@が書き込みを続けるには足りません。空き容量を確保してから再開してください。%3$@が動作を続けるには%4$@の空き容量が必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备仅剩%1$@可用空间，%2$@无法继续写入。请释放空间，然后继续。%3$@需要%4$@可用空间才能恢复运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置僅剩%1$@可用空間，%2$@無法繼續寫入。請釋出空間，然後繼續。%3$@需要%4$@可用空間才能恢復執行。"
          }
        }
      }
    },
    "This device has %@ of free space left. %@ is saving what it has to storage." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスの空き容量は残り%1$@です。%2$@はデータをストレージに保存しています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备仅剩%1$@可用空间。%2$@正在将数据保存到储存空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置僅剩%1$@可用空間。%2$@正在將資料寫入儲存空間。"
          }
        }
      }
    },
    "This device has no gyroscope or accelerometer to share." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスには利用可能なジャイロスコープや加速度センサーがありません。"
