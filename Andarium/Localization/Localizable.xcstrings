    "Take one to keep the virtual machine’s data as it is now and go back to it later." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スナップショットを作成すると、ゲストの現在のデータを保存して、あとで元に戻せます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "创建一个快照，即可保留客户机当前的数据，以后随时恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建立快照即可保留客體目前的資料，日後可隨時還原。"
          }
        }
      }
    },
