    "Tap for Back, Home and Settings. Hold Power for the power menu. Drag to move." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タップで“戻る”、“ホーム”、“設定”を使えます。“電源”を長押しすると電源メニューが開きます。ドラッグして移動できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按可使用“返回”、“主屏幕”和“设置”。按住“电源”可打开电源菜单。拖移可移动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
