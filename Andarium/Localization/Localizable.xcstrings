          }
        }
      }
    },
    "The growth to %@ is cancelled." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@への拡張は取り消されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扩展到 %@ 的操作已取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "擴增到 %@ 的操作已取消。"
          }
        }
      }
    },
    "The next start updates it to %@." : {
      "comment" : "Follows the note above when a restore brings an older system back; %@ is the release.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次回の起動時に%@へアップデートされます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下次启动时会将其更新到 %@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下次啟動時會將其更新到 %@。"
          }
        }
      }
    },
    "The virtual machine asks to allow the computer the first time it connects. ADB turns off when the virtual machine stops or USB debugging is turned off." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンピュータが初めて接続するときに、ゲストが許可を求めます。ゲストが停止するか、USBデバッグがオフになると、ADBはオフになります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "客户机会在电脑首次连接时请求允许。客户机停止或关闭 USB 调试后，ADB 会关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "客體會在電腦首次連線時請求允許。客體停止或關閉 USB 偵錯後，ADB 會關閉。"
          }
        }
      }
    },
    "This can’t be undone." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この操作は取り消せません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作無法還原。"
          }
        }
      }
    },
    "This device has %@ of free space left and %@ could not be paused. Shut it down before the space runs out, or free up space and check again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスの空き容量は残り%1$@で、%2$@を一時停止できませんでした。空き容量がなくなる前にシャットダウンするか、空き容量を確保してからもう一度確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备仅剩 %1$@ 可用空间，%2$@ 无法暂停。请在空间用尽前将其关机，或释放空间后重新检查。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置僅剩 %1$@ 可用空間，%2$@ 無法暫停。請在空間用盡前將其關機，或釋出空間後重新檢查。"
          }
        }
      }
    },
    "This device has %@ of free space left, too little for %@ to keep writing. Free up space, then resume. %@ needs %@ free to continue." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスの空き容量は残り%1$@で、%2$@が書き込みを続けるには足りません。空き容量を確保してから再開してください。%3$@が続行するには%4$@の空き容量が必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备仅剩 %1$@ 可用空间，%2$@ 无法继续写入。请释放空间，然后继续。%3$@ 需要 %4$@ 可用空间才能继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置僅剩 %1$@ 可用空間，%2$@ 無法繼續寫入。請釋出空間，然後繼續。%3$@ 需要 %4$@ 可用空間才能繼續。"
          }
        }
      }
    },
    "This device has %@ of free space left. %@ is saving what it has to storage." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスの空き容量は残り%1$@です。%2$@はデータをストレージに保存しています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备仅剩 %1$@ 可用空间。%2$@ 正在将数据保存到储存空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置僅剩 %1$@ 可用空間。%2$@ 正在將資料儲存到儲存空間。"
          }
        }
      }
    },
    "This device has no gyroscope or accelerometer to share." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスには共有できるジャイロスコープや加速度センサーがありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备没有可共享的陀螺仪或加速度计。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置沒有可共享的陀螺儀或加速度計。"
          }
        }
      }
    },
    "Turn on USB debugging in the virtual machine’s Developer options to use ADB over network." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネットワーク経由のADBを使うには、ゲストの「開発者向けオプション」でUSBデバッグをオンにしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要通过网络使用 ADB，请在客户机的“开发者选项”中开启 USB 调试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要透過網路使用 ADB，請在客體的「開發人員選項」中開啟 USB 偵錯。"
          }
        }
