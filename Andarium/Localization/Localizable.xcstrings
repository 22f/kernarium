        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置沒有可供使用的陀螺儀或加速度計。"
          }
        }
      }
    },
    "This device has no Wi-Fi address. Connect to Wi-Fi to use ADB over network." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスにはWi-Fiアドレスがありません。ネットワーク経由のADBを使うには、Wi-Fiに接続してください。"
          }
