          }
        }
      }
    },
    "The snapshot could not be taken" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スナップショットを作成できませんでした"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法创建快照"
          }
        },
