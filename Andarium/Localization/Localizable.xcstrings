          }
        }
      }
    },
    "The virtual machine is starting or running. Snapshots can be taken, restored and deleted only while it is stopped." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仮想マシンは起動中または実行中です。スナップショットの作成、復元、削除は、仮想マシンが停止している間のみ行えます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虚拟机正在启动或运行。只有在其停止时才能创建、恢复和删除快照。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
