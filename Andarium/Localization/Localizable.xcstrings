          }
        }
      }
    },
    "The last attempt stopped: %@" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前回の試行は停止しました: %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上次尝试已停止：%@"
