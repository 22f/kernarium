{
  "sourceLanguage" : "en",
  "strings" : {
    "%lld vCPUs" : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld vCPU"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld vCPUs"
                }
              }
            }
          }
        },
        "ja" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld個のvCPU"
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld个vCPU"
                }
              }
            }
          }
        },
        "zh-Hant" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld個vCPU"
                }
              }
            }
          }
        }
      }
    },
    "Above %@, games may run out of graphics memory." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を超えると、ゲームでグラフィックスメモリが不足する可能性があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超过%@时，游戏可能会耗尽图形内存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超過%@時，遊戲可能會耗盡圖形記憶體。"
          }
        }
      }
    },
    "Andarium draws the virtual machine with Metal 4, which this %@ does not have, so the virtual machine cannot start here." : {
      "comment" : "%@ is the device name: iPhone, iPad or Mac.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AndariumはMetal 4で仮想マシンを描画しますが、この%@はMetal 4に対応していないため、ここでは仮想マシンを起動できません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andarium使用Metal 4绘制虚拟机，而此%@不支持Metal 4，因此虚拟机无法在此启动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andarium使用Metal 4繪製虛擬機器，而此%@不支援Metal 4，因此虛擬機器無法在此啟動。"
          }
        }
      }
    },
    "Android ran out of graphics memory" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Androidのグラフィックスメモリが不足しました"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android图形内存不足"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android圖形記憶體不足"
          }
        }
      }
    },
    "Apps that come in several files can’t be installed yet. Choose a single .apk file." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複数のファイルで構成されたアプリはまだインストールできません。単一の.apkファイルを選択してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂不支持安装由多个文件组成的应用。请选择单个.apk文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前尚不支援安裝由多個檔案組成的應用程式。請選擇單一.apk檔案。"
          }
        }
      }
    },
    "arm64, %lld KiB pages" : {
      "comment" : "The architecture row of the Info sheet: the CPU architecture, then the size of a memory page, as in arm64, 4 KiB pages.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "arm64、%lld KiBページ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "arm64，%lld KiB页面"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "arm64，%lld KiB頁面"
          }
        }
      }
    },
    "Dismiss" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "閉じる"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉"
          }
        }
      }
    },
    "Frame rate lowered while this device is hot" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスが高温のため、フレームレートを下げています"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设备发热期间已降低帧速率"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "裝置發熱期間已降低影格率"
          }
        }
      }
    },
    "If an app looks broken, swipe it away in Recents and open it again." : {
      "comment" : "Recents is Android's list of recent apps inside the virtual machine; use the virtual machine's own name for it.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリの表示がおかしい場合は、“最近使用したアプリ”でそのアプリを上にスワイプして終了し、もう一度開いてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果应用显示异常，请在“最近使用的应用”中将其划掉，然后重新打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果應用程式顯示異常，請在「最近使用的應用程式」中將其滑掉，然後重新開啟。"
          }
        }
      }
    },
    "In Settings while the virtual machine runs" : {
      "comment" : "Where a feature is found: in the Settings sheet that opens while the virtual machine runs.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仮想マシンの実行中は設定内で"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虚拟机运行期间，在设置中"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虛擬機器執行期間，在設定中"
          }
        }
      }
    },
    "iOS is likely to close Andarium above %@." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を超えると、iOSによってAndariumが終了される可能性が高くなります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超过%@时，iOS很可能会关闭Andarium。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超過%@時，iOS很可能會關閉Andarium。"
          }
        }
      }
    },
    "iOS is likely to close Andarium with %@ of virtual machine memory on this %@. %@ or less is safer. Lower it with Edit under Virtual machine." : {
      "comment" : "Arguments: virtual machine memory, device name, the safer size. Edit and Virtual machine are labels on Home.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この%2$@で仮想マシンのメモリが%1$@の場合、iOSによってAndariumが終了される可能性が高くなります。%3$@以下にすると安全です。“仮想マシン”の“編集”で下げてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此%2$@上的虚拟机内存为%1$@时，iOS很可能会关闭Andarium。%3$@或更低更为安全。请使用“虚拟机”下的“编辑”降低内存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此%2$@上的虛擬機器記憶體為%1$@時，iOS很可能會關閉Andarium。%3$@或更低更為安全。請使用「虛擬機器」下的「編輯」降低記憶體。"
          }
        }
      }
    },
    "list.join" : {
      "comment" : "Joins two parts of a spoken list: a comma and a space in English, the language's own comma in Chinese and Japanese.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@、%2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@，%2$@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@，%2$@"
          }
        }
      }
    },
    "Needs an A14 chip or later" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A14チップ以降が必要です"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要A14或更新的芯片"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要A14或更新的晶片"
          }
        }
      }
    },
    "sentence.join" : {
      "comment" : "Joins two whole sentences: a space in English, none in Chinese and Japanese.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@%2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@%2$@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@%2$@"
          }
        }
      }
    },
    "The virtual machine cannot start from %@: its name has a space, comma, colon or quotation mark." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仮想マシンは%@から起動できません。名前にスペース、カンマ、コロン、引用符が含まれています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虚拟机无法从%@启动：其名称含有空格、逗号、冒号或引号。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虛擬機器無法從%@啟動：其名稱含有空格、逗號、冒號或引號。"
          }
        }
      }
    },
    "The virtual machine's data uses a newer layout than this app version can open. Erase the virtual machine to start again with this one." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仮想マシンのデータは、このバージョンのアプリでは開けない新しい形式です。仮想マシンを消去して、このバージョンで最初からやり直してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虚拟机数据的格式比此App版本支持的更新。请抹掉虚拟机，以便用此版本重新开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虛擬機器資料的格式比此App版本支援的更新。請清除虛擬機器，以便用此版本重新開始。"
          }
        }
      }
    },
    "The virtual machine's files do not match this app version. Erase the virtual machine to start again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仮想マシンのファイルがこのバージョンのアプリと一致しません。仮想マシンを消去して最初からやり直してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虚拟机的文件与此App版本不匹配。请抹掉虚拟机以重新开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虛擬機器的檔案與此App版本不相符。請清除虛擬機器以重新開始。"
          }
        }
      }
    },
    "There is not enough free storage to set up the virtual machine." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ストレージの空き容量が足りないため、仮想マシンを設定できません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可用储存空间不足，无法设置虚拟机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可用儲存空間不足，無法設定虛擬機器。"
          }
        }
      }
    },
    "This app version is older than the one the virtual machine last started with, and its data does not go back. Install a newer version of Andarium, or erase the virtual machine to start again with this one." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このバージョンのアプリは、仮想マシンが前回起動したときのバージョンより古く、仮想マシンのデータを古いバージョンに戻すことはできません。新しいバージョンのAndariumをインストールするか、仮想マシンを消去してこのバージョンで最初からやり直してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此App版本比虚拟机上次启动时使用的版本更旧，且虚拟机数据无法降级到旧版本。请安装更高版本的Andarium，或抹掉虚拟机以使用此版本重新开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此App版本比虛擬機器上次啟動時使用的版本更舊，且虛擬機器資料無法降級回舊版本。請安裝較新版本的Andarium，或清除虛擬機器以使用此版本重新開始。"
          }
        }
      }
    },
    "This copy of Andarium does not carry a system." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このAndariumにはシステムが含まれていません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此Andarium副本不含系统。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此Andarium拷貝不含系統。"
          }
        }
      }
    },
    "This isn’t an app. Choose a file that ends in .apk." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはアプリではありません。.apkで終わるファイルを選択してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这不是应用。请选择以.apk结尾的文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這不是應用程式。請選擇以.apk結尾的檔案。"
          }
        }
      }
    },
    "This virtual machine cannot start" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この仮想マシンは起動できません"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此虚拟机无法启动"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此虛擬機器無法啟動"
          }
        }
      }
    },
    "Virtual machine memory is high" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仮想マシンのメモリが大きすぎます"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虚拟机内存偏高"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虛擬機器記憶體偏高"
          }
        }
      }
    },
    "VRAM" : {
      "comment" : "Graphics memory of the virtual machine (video RAM).",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VRAM"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VRAM"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VRAM"
          }
        }
      }
    },
    "VRAM is graphics memory, separate from the virtual machine’s RAM." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VRAMはグラフィックスメモリで、仮想マシンのRAMとは別です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VRAM是图形内存，与虚拟机的RAM相互独立。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VRAM是圖形記憶體，與虛擬機器的RAM各自獨立。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
